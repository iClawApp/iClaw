<aside class="col col-left">
  <div class="sidebar-top">
    <form method="post" action="/chats" class="new-chat-form">
      <button type="submit" class="new-chat-btn">+ New chat</button>
    </form>
  </div>

  <nav class="chat-list">
    <% if (chats.length === 0) { %>
      <p class="muted empty-list">No chats yet.</p>
    <% } %>
    <% chats.forEach(function (c) { %>
      <a
        href="/chats/<%= c.id %>"
        class="chat-item <%= activeChat && activeChat.id === c.id ? 'active' : '' %>"
        title="<%= c.title %>"
      >
        <span class="chat-item-title"><%= c.title %></span>
      </a>
    <% }); %>
  </nav>
</aside>
