<%
  const _projectsList = typeof allProjects !== 'undefined' && Array.isArray(allProjects)
    ? allProjects
    : (typeof projectsList !== 'undefined' ? projectsList : []);
  const _projectsMap = new Map();
  for (const p of _projectsList) {
    _projectsMap.set(p.id, p);
  }
%>
<aside class="col col-left" id="app-sidebar">
  <div class="sidebar-top">
    <div class="sidebar-toolbar">
      <a
        href="/settings"
        class="sidebar-settings-btn<%= typeof activeSettings !== 'undefined' && activeSettings ? ' active' : '' %>"
        aria-label="Settings"
        title="Settings"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </a>
      <a href="/" class="new-chat-btn <%= !activeChat && !activeProject && !(typeof activeProjectsList !== 'undefined' && activeProjectsList) ? 'active' : '' %>">New chat</a>
      <div class="sidebar-search-slot">
        <button
          type="button"
          class="sidebar-search-toggle"
          id="sidebar-search-toggle"
          aria-label="Search chats"
          aria-expanded="false"
          aria-controls="sidebar-search-input"
        >
          <svg class="sidebar-search-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
            />
          </svg>
        </button>
        <div class="sidebar-search-field-wrap" id="sidebar-search-field-wrap">
          <input
            type="search"
            id="sidebar-search-input"
            name="sidebar-search"
            placeholder="Search chats…"
            autocomplete="off"
            aria-label="Search chats by title or message text"
            spellcheck="false"
          />
          <button type="button" class="sidebar-search-close" id="sidebar-search-close" aria-label="Close search">
            <span aria-hidden="true">×</span>
          </button>
        </div>
      </div>
    </div>
    <p id="sidebar-search-status" class="sidebar-search-status" hidden aria-live="polite"></p>
    <div class="sidebar-projects-nav">
      <a
        href="/projects"
        class="sidebar-projects-btn<%= typeof activeProjectsList !== 'undefined' && activeProjectsList ? ' active' : '' %>"
      >Projects</a>
      <% if (typeof hasAnyTasks !== 'undefined' && hasAnyTasks) {
        const _taskSignals = typeof taskStatusSignals !== 'undefined' ? taskStatusSignals : {};
        const _taskDotHuman = _taskSignals.needsHuman;
        const _taskDotRunning = _taskSignals.running;
        const _taskDotReview = _taskSignals.needsReview;
        const _taskDotAny = _taskDotHuman || _taskDotRunning || _taskDotReview;
      %>
      <a
        href="/tasks"
        class="sidebar-projects-btn<%= typeof activeTasksList !== 'undefined' && activeTasksList ? ' active' : '' %>"
        id="sidebar-tasks-link"
      >
        <span class="sidebar-projects-btn__label">Tasks</span>
        <% if (_taskDotAny) { %>
        <span class="sidebar-tasks-dots" aria-hidden="true">
          <% if (_taskDotHuman) { %><span class="status-dot task-human"></span><% } %>
          <% if (_taskDotRunning) { %><span class="status-dot working"></span><% } %>
          <% if (_taskDotReview) { %><span class="status-dot task-review"></span><% } %>
        </span>
        <% } %>
      </a>
      <% } %>
    </div>
  </div>

  <% if (chats.length > 0) { %>
    <!-- Discovery hint for the right-click context menu (Share / Rename /
         Mark unread / Delete). JS gates with localStorage: hides forever
         on the first contextmenu, throttles to once per day until then. -->
    <div
      id="sidebar-hint-pill"
      class="sidebar-hint-pill"
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="sidebar-hint-pill__text">Tip: right-click a chat for options</span>
    </div>
  <% } %>

  <nav class="chat-list" id="chat-list">
    <% if (chats.length > 0) { %>
      <% const _scheduledChatIds = typeof scheduledChatIds !== 'undefined' ? scheduledChatIds : []; %>
      <% chats.forEach(function (c) {
        const dotWorking = workingIds.indexOf(c.id) >= 0;
        const dotUnread = !dotWorking && c.unread;
        const dotScheduled = !dotWorking && !dotUnread && _scheduledChatIds.indexOf(c.id) >= 0;
        const p = c.project_id ? _projectsMap.get(c.project_id) : null;
      %>
        <a
          href="/chats/<%= c.id %>"
          class="chat-item<%= activeChat && activeChat.id === c.id ? ' active' : '' %>"
          data-chat-id="<%= c.id %>"
          data-project-id="<%= c.project_id != null ? c.project_id : '' %>"
          data-updated-at="<%= c.updated_at %>"
        >
          <span class="chat-item-avatar-wrap">
          <% if (p) { %>
            <span class="chat-item-project-mark" aria-hidden="true">
              <%- include('./projectLogo', {
                emojiIndex: typeof p.logo_emoji === 'number' ? p.logo_emoji : 0,
                colorIndex: typeof p.logo_color === 'number' ? p.logo_color : 0,
              }) %>
            </span>
          <% } else if (c.project_id) { %>
            <span class="chat-item-project-mark" aria-hidden="true">
              <%- include('./projectLogo', { emojiIndex: 0, colorIndex: 0 }) %>
            </span>
          <% } else { %>
            <span class="chat-item-project-mark chat-item-project-mark--spacer" aria-hidden="true"></span>
          <% } %>
            <span
              class="status-dot<%= dotWorking ? ' working' : (dotUnread ? ' unread' : (dotScheduled ? ' scheduled' : '')) %>"
              <% if (dotScheduled) { %>aria-label="Scheduled message pending"<% } else { %>aria-hidden="true"<% } %>
            ></span>
          </span>
          <span class="chat-item-title"><%= c.title %></span>
        </a>
      <% }); %>
    <% } %>

    <% if (chats.length === 0 && _projectsList.length === 0) { %>
      <p class="muted empty-list">No projects or chats yet.</p>
    <% } else if (chats.length === 0) { %>
      <p class="muted empty-list">No chats yet. Click <strong>+ New chat</strong> and pick a project on the home screen.</p>
    <% } %>

    <div id="sidebar-list-tail" class="sidebar-list-tail" aria-hidden="true"></div>
  </nav>

  <div
    id="sidebar-update-banner"
    class="sidebar-update-banner"
    hidden
    role="status"
    aria-live="polite"
  >
    <p class="sidebar-update-banner__title">Update ready</p>
    <p class="sidebar-update-banner__subtitle" id="sidebar-update-status">
      Your chats keep working
    </p>
    <button type="button" class="sidebar-update-banner__run" id="sidebar-update-run">
      Update now
    </button>
  </div>

  <div
    id="sidebar-gateway-banner"
    class="sidebar-update-banner sidebar-gateway-banner"
    hidden
    role="status"
    aria-live="polite"
  >
    <p class="sidebar-update-banner__title">OpenClaw is off</p>
    <p class="sidebar-update-banner__subtitle" id="sidebar-gateway-status">
      Your chats keep working
    </p>
    <button type="button" class="sidebar-update-banner__run" id="sidebar-gateway-start">
      Start OpenClaw
    </button>
  </div>
</aside>
<div class="sidebar-backdrop" id="sidebar-backdrop" hidden aria-hidden="true"></div>

<!-- iclaw.js handles sidebar live updates via the page-level WS connection -->
