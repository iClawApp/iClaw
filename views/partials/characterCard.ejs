<%# One teammate tile for the launcher ("AI Employees" style): a themed gradient
    card with the character render filling it (face + upper body) and the name/role
    at the bottom over a colour scrim. A plain link to /start/:id. `ch` = CharacterDef. %>
<a class="chat-launcher-card" href="/start/<%= ch.id %>" data-character="<%= ch.id %>" data-logo-color="<%= ch.color %>">
  <% if (ch.art) { %>
    <img class="chat-launcher-card-art" src="<%= ch.art %>" alt="" aria-hidden="true" loading="lazy" />
  <% } else { %>
    <span class="chat-launcher-card-face"><%- include('characterFace', { character: ch, faceClass: 'chat-launcher-face' }) %></span>
  <% } %>
  <span class="chat-launcher-card-head">
    <span class="chat-launcher-card-name"><%= ch.name %></span>
    <% if (ch.role) { %><span class="chat-launcher-card-role"><%= ch.role %></span><% } %>
  </span>
</a>
