<%# Gateway/agents connection failure notice.
    Expects: agentsError (string), gatewayUp (bool), openclawBaseUrl (string).
    Plain-language explanation first; raw technical detail kept below for support. %>
<div class="draft-agents-error" role="alert">
  <p class="draft-agents-error__title">Can't connect to OpenClaw</p>
  <p class="draft-agents-error__hint">
    <% if (gatewayUp) { %>
      OpenClaw is running, but iClaw couldn't connect to it — so you can't start a
      chat just yet. Usually this means OpenClaw is set up on a different address
      than iClaw is looking at, or the access key doesn't match.
    <% } else { %>
      iClaw couldn't find OpenClaw at the address below — so you can't start a chat
      just yet. It may not be running, or it's running somewhere else.
    <% } %>
  </p>
  <p class="draft-agents-error__detail">
    <span class="draft-agents-error__detail-label">Details</span>
    iClaw tried <code><%= openclawBaseUrl %></code> — <%= agentsError %>
  </p>
  <button
    type="button"
    class="btn btn--sm draft-agents-error__retry"
    onclick="window.location.reload()"
  >Try again</button>
</div>
