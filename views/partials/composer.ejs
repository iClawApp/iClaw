<%
  // Render any rows that are still pending so the banner is correct on first
  // paint (before the WS connection comes online). JS hydrates from /scheduled
  // for fallbacks and listens for `scheduled-added`/`scheduled-deleted` live.
  const _scheduled =
    typeof scheduledList !== 'undefined' && Array.isArray(scheduledList)
      ? scheduledList
      : [];
  const _queue =
    typeof queueList !== 'undefined' && Array.isArray(queueList) ? queueList : [];
%>
<div
  id="queue-list"
  class="scheduled-list scheduled-list--queue<%= _queue.length === 0 ? ' is-empty' : '' %>"
  aria-live="polite"
><% _queue.forEach(function (q, idx) { %>
  <%- include('composer-pending-row', {
    kind: 'queue',
    rowId: q.id,
    metaIcon: '⏳',
    metaText: 'In queue #' + (idx + 1),
    content: q.content,
  }) %>
<% }); %></div>
<div
  id="scheduled-list"
  class="scheduled-list<%= _scheduled.length === 0 ? ' is-empty' : '' %>"
  aria-live="polite"
><% _scheduled.forEach(function (s) { %>
  <%- include('composer-pending-row', {
    kind: 'scheduled',
    rowId: s.id,
    metaIcon: '⏰',
    metaText: s.scheduled_at,
    content: s.content,
    scheduledAt: s.scheduled_at,
  }) %>
<% }); %></div>

<%
  // Mode selector data. Server passes the enabled modes (config-driven) and
  // the default. Fall back gracefully if a render path forgot the locals so
  // the composer never breaks — the selector just hides.
  const _modes =
    typeof chatModes !== 'undefined' && Array.isArray(chatModes) ? chatModes : [];
  const _defaultMode =
    typeof defaultChatMode !== 'undefined' && defaultChatMode ? defaultChatMode : 'execute';
  const _defaultModeDef =
    _modes.find(function (m) { return m.id === _defaultMode; }) || _modes[0] || null;
%>
<form id="send-form" class="composer">
  <% if (_modes.length > 1 && _defaultModeDef) { %>
  <!-- Mode selector — Ask (lightweight) vs Execute (full agent). Minimal pill
       + dropdown; the chosen mode rides along with each sent message. JS
       hydrates the active mode from localStorage on load. -->
  <div class="composer-modes" id="composer-modes" data-default-mode="<%= _defaultMode %>">
    <button
      type="button"
      class="composer-mode-btn"
      id="composer-mode-btn"
      data-mode="<%= _defaultMode %>"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="composer-mode-menu"
      title="<%= _defaultModeDef.description %>"
    >
      <span class="composer-mode-btn__label" id="composer-mode-label"><%= _defaultModeDef.label %></span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
    <div
      id="composer-mode-menu"
      class="menu composer-mode-menu"
      role="menu"
      aria-label="Message mode"
      hidden
    ><% _modes.forEach(function (m) { %>
      <button
        type="button"
        class="menu-item composer-mode-menu-item"
        role="menuitemradio"
        data-mode="<%= m.id %>"
        aria-checked="<%= m.id === _defaultMode ? 'true' : 'false' %>"
      >
        <span class="menu-item__title"><%= m.label %></span>
        <span class="composer-mode-menu-item__desc"><%= m.description %></span>
      </button><% }); %>
    </div>
  </div>
  <% } %>
  <div id="composer-reply-bar" class="composer-reply-bar" hidden>
    <div class="composer-reply-bar-inner">
      <span class="composer-reply-accent" aria-hidden="true"></span>
      <div class="composer-reply-main">
        <div class="composer-reply-meta" id="composer-reply-meta"></div>
        <div class="composer-reply-text" id="composer-reply-text"></div>
      </div>
      <button
        type="button"
        class="composer-reply-clear btn btn--icon btn--ghost"
        id="composer-reply-clear"
        aria-label="Clear quote"
      >×</button>
    </div>
  </div>
  <div id="composer-attachments" class="composer-attachments" hidden></div>
  <div class="composer-field">
    <div class="composer-drop-overlay" id="composer-drop-overlay" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      <span>Drop file here</span>
    </div>
    <input
      type="file"
      id="composer-file-input"
      class="composer-file-input"
      multiple
      hidden
    />
    <div
      id="composer-attach-menu"
      class="menu composer-attach-menu"
      role="menu"
      aria-label="Attachments"
      hidden
    >
      <button type="button" class="menu-item composer-attach-menu-item" data-attach-pick="file" role="menuitem">
        <span class="menu-item__title">File</span>
      </button>
      <button type="button" class="menu-item composer-attach-menu-item" data-attach-pick="secret" role="menuitem">
        <span class="menu-item__title">Secret</span>
      </button>
    </div>
    <div
      id="composer-secret-pick-menu"
      class="menu composer-secret-pick-menu"
      role="menu"
      aria-label="Choose secret"
      hidden
    ></div>
    <!-- Work Mode folders button — shown only when mode=work -->
    <button
      type="button"
      class="composer-work-folders"
      id="composer-work-folders-btn"
      aria-label="Work Mode folders"
      title="Configure allowed folders for Work Mode"
      hidden
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="composer-work-folders__count" id="composer-work-folders-count"></span>
    </button>
    <button
      type="button"
      class="composer-attach"
      id="composer-attach-btn"
      aria-label="Add attachment"
      title="File or secret (also drag &amp; drop and paste)"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="composer-attach-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l8.57-8.57A4 4 0 1117.95 8.83l-8.59 8.57a2 2 0 01-2.83-2.83l8.49-8.49"/>
      </svg>
    </button>
    <div class="composer-input-stack">
      <textarea
        id="composer-input"
        name="content"
        placeholder="Message…"
        rows="1"
      ></textarea>
    </div>
    <% if (typeof sttEnabled !== 'undefined' && sttEnabled) { %>
    <!-- Speech-to-text mic. Click to record, click to stop; the transcript is
         inserted into the textarea. Only rendered when OPENROUTER_API_KEY is
         set (see routes → sttEnabled). JS lives in iclaw.js. -->
    <button
      type="button"
      class="composer-mic"
      id="composer-mic-btn"
      data-state="idle"
      aria-label="Record voice"
      aria-pressed="false"
      title="Record voice"
    >
      <svg class="composer-mic__idle" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
        <line x1="12" y1="19" x2="12" y2="22"/>
      </svg>
      <svg class="composer-mic__busy" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
      </svg>
    </button>
    <% } %>
    <button
      type="submit"
      class="composer-send"
      id="composer-send-btn"
      aria-label="Send (hold to schedule)"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>

    <% if (typeof sendHintShow !== 'undefined' && sendHintShow) { %>
      <!-- Discovery pill — surfaces the long-press menu (scheduled msg / create
           task) for users who haven't crossed the usage threshold yet. JS
           gates this to once-per-day via localStorage. Auto-dismisses on
           timer, on textarea focus, or on Send pointerdown — no manual close. -->
      <div
        id="send-hint-pill"
        class="send-hint-pill"
        role="status"
        aria-live="polite"
        hidden
      >
        <span class="send-hint-pill__text">Did you know? Hold Send for more</span>
      </div>
    <% } %>

    <!-- Schedule menu — anchored to the send button. JS shows it on long-press
         and on right-click. Stays out of the tab order until visible. -->
    <div
      id="schedule-menu"
      class="schedule-menu"
      role="menu"
      aria-label="Send actions"
      hidden
    >
      <div class="schedule-menu-panel" id="schedule-menu-main" data-panel="main">
        <button type="button" class="schedule-menu-item" data-action="open-schedule" role="menuitem">
          Scheduled message
        </button>
        <button type="button" class="schedule-menu-item" data-action="create-task" role="menuitem">
          Create task
        </button>
      </div>
      <div class="schedule-menu-panel" id="schedule-menu-schedule" data-panel="schedule" hidden>
        <button type="button" class="schedule-menu-item schedule-menu-item--back" data-action="schedule-back" role="menuitem">
          ‹ Back
        </button>
        <div class="schedule-menu-divider" role="separator" aria-hidden="true"></div>
        <button type="button" class="schedule-menu-item" data-offset="5m" role="menuitem">5 min</button>
        <button type="button" class="schedule-menu-item" data-offset="30m" role="menuitem">30 min</button>
        <button type="button" class="schedule-menu-item" data-offset="1h" role="menuitem">1 hour</button>
        <button type="button" class="schedule-menu-item" data-offset="tomorrow9" role="menuitem">Tomorrow at 9:00</button>
        <button type="button" class="schedule-menu-item" data-offset="custom" role="menuitem">Pick time</button>
      </div>
    </div>

    <div
      id="schedule-picker"
      class="schedule-picker"
      role="dialog"
      aria-modal="true"
      aria-label="Pick time"
      hidden
    >
      <div class="schedule-picker__backdrop" id="schedule-picker-backdrop"></div>
      <div class="schedule-picker__panel">
        <header class="schedule-picker__head">
          <button type="button" class="schedule-picker__cancel" id="schedule-picker-cancel">Cancel</button>
          <span class="schedule-picker__title">Send at</span>
          <button type="button" class="schedule-picker__confirm" id="schedule-picker-confirm">Done</button>
        </header>
        <div class="schedule-picker__body">
          <label class="schedule-picker__field" for="schedule-datetime-input">
            <span class="schedule-picker__field-label">Date &amp; time</span>
            <input
              type="datetime-local"
              id="schedule-datetime-input"
              class="schedule-picker__native"
            />
          </label>
        </div>
      </div>
    </div>
  </div>
  <div class="composer-secret-ui" id="composer-secret-ui" hidden>
    <div class="composer-secret-rows">
      <div class="composer-secret-row" id="composer-token-hint" hidden>
        <span class="composer-secret-caption" id="composer-token-hint-text"></span>
        <button type="button" class="composer-secret-link" id="composer-token-save-btn">Hide</button>
      </div>
      <div class="composer-secret-row" id="composer-selection-hint" hidden>
        <span class="composer-secret-caption">Selection in message</span>
        <button type="button" class="composer-secret-link" id="composer-mark-secret-btn">Hide</button>
      </div>
    </div>
  </div>
  <div class="composer-secret-modal" id="composer-secret-modal" hidden>
    <div class="composer-secret-modal__backdrop" id="composer-secret-modal-backdrop"></div>
    <div class="composer-secret-modal__panel" role="dialog" aria-modal="true" aria-labelledby="composer-secret-modal-title">
      <header class="composer-secret-modal__head">
        <h3 class="composer-secret-modal__title" id="composer-secret-modal-title">Secret name</h3>
        <p class="composer-secret-modal__hint muted">Will appear under Secrets on the project page.</p>
      </header>
      <label class="composer-secret-modal__field composer-secret-modal__field--name">
        <span class="composer-secret-modal__caption">Name</span>
        <input
          type="text"
          id="composer-secret-label-input"
          autocomplete="off"
          maxlength="160"
          placeholder="e.g. OpenAI API key"
        />
      </label>
      <div
        class="composer-secret-modal__field composer-secret-modal__field--token"
        role="group"
        aria-labelledby="composer-secret-token-label"
      >
        <span class="composer-secret-modal__caption" id="composer-secret-token-label">Token</span>
        <div class="composer-secret-modal__token-row">
          <code class="composer-secret-modal__token-mask" id="composer-secret-value-preview"></code>
          <textarea
            class="composer-secret-modal__token-input"
            id="composer-secret-value-input"
            hidden
            rows="1"
            autocomplete="off"
            spellcheck="false"
          ></textarea>
          <button
            type="button"
            class="btn btn--icon btn--ghost composer-secret-modal__token-toggle"
            id="composer-secret-token-toggle"
            aria-label="Edit token"
            aria-pressed="false"
            title="Edit token"
          >
            <svg class="composer-secret-modal__eye-open" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <svg class="composer-secret-modal__eye-off" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-8-10-8a18.45 18.45 0 0 1 5.06-6.94"/>
              <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19"/>
              <line x1="1" y1="1" x2="23" y2="23"/>
            </svg>
          </button>
        </div>
      </div>
      <div class="composer-secret-modal__actions">
        <button type="button" class="btn btn--primary btn--sm" id="composer-secret-ok">Done</button>
      </div>
    </div>
  </div>
</form>

<div class="create-task-modal" id="create-task-modal" hidden>
    <div class="create-task-modal__backdrop" id="create-task-modal-backdrop"></div>
    <div class="create-task-modal__panel" role="dialog" aria-modal="true" aria-labelledby="create-task-modal-title">
      <header class="create-task-modal__head">
        <h3 class="create-task-modal__title" id="create-task-modal-title">Create agent task</h3>
        <p class="create-task-modal__hint muted">
          Runs in the background on a snapshot of this chat. Hold <strong>Send</strong> to reopen this.
        </p>
      </header>
      <label class="create-task-modal__field create-task-modal__field--goal">
        <span class="create-task-modal__caption">Goal</span>
        <textarea id="create-task-goal" class="create-task-goal-input iclaw-thin-scroll" rows="8" placeholder="What should the agent do?"></textarea>
      </label>
      <div class="create-task-modal__actions">
        <button type="button" class="btn btn--ghost btn--sm" id="create-task-cancel">Cancel</button>
        <button type="button" class="btn btn--primary btn--sm" id="create-task-submit">Create task</button>
      </div>
    </div>
  </div>

<!-- Work Mode folders modal -->
<div class="work-folders-modal" id="work-folders-modal" hidden>
  <div class="work-folders-modal__backdrop" id="work-folders-backdrop"></div>
  <div class="work-folders-modal__panel" role="dialog" aria-modal="true" aria-labelledby="work-folders-title">
    <header class="work-folders-modal__head">
      <h3 class="work-folders-modal__title" id="work-folders-title">Work Mode folders</h3>
      <p class="work-folders-modal__hint muted">AI can only read and write inside these folders.</p>
    </header>
    <ul class="work-folders-list" id="work-folders-list"></ul>
    <div class="work-folders-add">
      <button type="button" class="btn btn--primary btn--sm" id="work-folders-browse-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        Browse…
      </button>
    </div>
  </div>
</div>
