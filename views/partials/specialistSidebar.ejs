<%# Themed per-specialist sidebar (Sintra-style): replaces the app sidebar when a
    chat belongs to a specialist. Full-bleed character render hero, name/role +
    a "+" new-chat button, the agent's power-up, and recents. A minimalist edge
    tab (left border, vertically centred) opens the all-project-chats menu. %>
<% var _pid = (typeof specialistProject !== 'undefined' && specialistProject) ? specialistProject.id : null; %>
<% var _recents = (typeof specialistChats !== 'undefined' && Array.isArray(specialistChats)) ? specialistChats : []; %>
<aside class="col col-left specialist-sidebar" id="app-sidebar" data-logo-color="<%= character.color %>">
  <div class="specialist-hero">
    <%# "‹ Project" goes to the project's home (the launcher scoped to this
        project — new-chat screen + its recents/drawer), NOT the /projects/:id
        overview page. No project → global home. %>
    <a class="specialist-hero-back" href="<%= _pid ? ('/?project=' + _pid) : '/' %>" aria-label="<%= _pid ? 'Back to project home' : 'Back to home' %>">&lsaquo; <%= _pid ? 'Project' : 'iClaw' %></a>
    <% if (character.art) { %>
      <img class="specialist-hero-art" src="<%= character.art %>" alt="" aria-hidden="true" />
    <% } else { %>
      <span class="specialist-hero-avatar"><%- include('characterFace', { character: character, faceClass: 'specialist-hero-face' }) %></span>
    <% } %>
  </div>

  <div class="specialist-id">
    <span class="specialist-id-text">
      <span class="specialist-id-name"><%= character.name %></span>
      <% if (character.role) { %><span class="specialist-id-role"><%= character.role %></span><% } %>
    </span>
    <%# "+" = start a new chat with this specialist (fresh). %>
    <% if (_pid) { %>
    <form method="post" action="/projects/<%= _pid %>/team/<%= character.id %>/chat" class="specialist-id-new-form">
      <input type="hidden" name="fresh" value="1" />
      <button type="submit" class="specialist-id-new" aria-label="New chat" title="New chat">+</button>
    </form>
    <% } else { %>
    <a class="specialist-id-new" href="/start/<%= character.id %>?fresh=1" aria-label="New chat" title="New chat">+</a>
    <% } %>
  </div>

  <div class="specialist-sb-body">
    <% var _panels = resolveCharacterPanels(character.id); %>
    <% if (_panels.length) { %>
    <button type="button" class="specialist-powerup" data-open-panel>
      <span class="specialist-powerup-icon" data-logo-color="<%= character.color %>" aria-hidden="true"><%- character.emoji %></span>
      <span class="specialist-powerup-text">
        <span class="specialist-powerup-label"><%= _panels[0].label %></span>
        <span class="specialist-powerup-sub"><%= _panels[0].sub %></span>
      </span>
      <span class="specialist-powerup-chevron" aria-hidden="true">&rsaquo;</span>
    </button>
    <% } %>

    <div class="specialist-recents<%= _recents.length ? '' : ' is-empty' %>">
      <% if (!_recents.length) { %>
      <p class="specialist-recents-placeholder">Your chats will appear here</p>
      <% } else { %>
      <p class="specialist-recents-label">Recents</p>
      <% _recents.forEach(function (c) { %>
      <a class="specialist-recent<%= c.id === activeChat.id ? ' on' : '' %>" href="/chats/<%= c.id %>"><%= c.title %></a>
      <% }); %>
      <% } %>
    </div>
  </div>
</aside>
