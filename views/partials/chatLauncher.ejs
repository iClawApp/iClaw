<%# Launcher hero: centered eyebrow + title + sub (and a small generalist face).
    The teammate roster lives in `chatRoster`, rendered BELOW the composer so the
    layout reads title → input → teammates (Sintra-style). Carries `empty-state`
    so clearEmptyState() drops it on first send. `characters` is the full roster. %>
<% var _gen = (characters || []).filter(function (c) { return c.id === 'generalist'; })[0]; %>
<div class="chat-launcher empty-state" id="welcome-card">
  <div class="chat-launcher-hero">
    <% if (_gen) { %>
    <span class="chat-launcher-gen" data-logo-color="<%= _gen.color %>">
      <%- include('characterFace', { character: _gen, faceClass: 'chat-launcher-gen-face' }) %>
    </span>
    <% } %>
    <p class="chat-launcher-eyebrow">iClaw</p>
    <h2 class="chat-launcher-title">What can we help with?</h2>
    <p class="chat-launcher-sub">Type below to chat with your assistant &mdash; or pick a teammate.</p>
  </div>
</div>
