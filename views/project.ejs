<%- include('partials/head', { title: project.name + ' — iClaude' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-center">
    <header class="col-header app-header">
      <h1><%= project.name %></h1>
    </header>

    <section class="welcome">
      <% if (project.description) { %>
        <p><%= project.description %></p>
      <% } %>
      <p class="muted">
        <%= tasks.length %> task<%= tasks.length === 1 ? '' : 's' %>.
        Pick one from the left or create a new one.
      </p>
    </section>
  </main>

  <aside class="col col-right">
    <header class="col-header"><h2>Notes</h2></header>
    <p class="muted">Open a task to see its pinned notes here.</p>
  </aside>
</div>

<%- include('partials/foot') %>
