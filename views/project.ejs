<%- include('partials/head', { title: project.name + ' — iClaw' }) %>
<% const _ei = (function () {
  const n = Number(project.logo_emoji);
  const em = Array.isArray(projectLogoEmojis) ? projectLogoEmojis : [];
  const max = em.length ? em.length - 1 : 9;
  if (!Number.isFinite(n) || n < 0) return 0;
  if (n > max) return max;
  return Math.floor(n);
})(); %>
<% const _ci = (function () {
  const n = Number(project.logo_color);
  if (!Number.isFinite(n) || n < 0) return 0;
  if (n > 9) return 9;
  return Math.floor(n);
})(); %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main project-page" data-project-id="<%= project.id %>">
    <header class="chat-header project-header">
      <%- include('partials/mobile-nav-toggle') %>
      <div class="project-header-primary">
        <div class="project-title-cluster">
          <button
            type="button"
            class="project-logo-trigger"
            id="project-logo-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Change project icon and color"
          >
            <%- include('partials/projectLogo', { emojiIndex: _ei, colorIndex: _ci }) %>
          </button>
          <form
            method="post"
            action="/projects/<%= project.id %>/rename"
            class="rename-form project-title-form"
            id="project-rename-form"
          >
            <input
              type="text"
              name="name"
              value="<%= project.name %>"
              aria-label="Project name"
              placeholder="Name"
            />
          </form>

          <div id="project-logo-popover" class="project-logo-popover" hidden>
            <p class="project-logo-popover-label">Emoji</p>
            <div class="project-logo-popover-row" role="group" aria-label="Emoji">
              <% (projectLogoEmojis || []).forEach(function (emo, idx) { %>
                <button
                  type="button"
                  class="project-logo-swatch project-logo-swatch--emoji<%= idx === _ei ? ' is-selected' : '' %>"
                  data-logo-emoji="<%= idx %>"
                  aria-label="Emoji <%= idx + 1 %>"
                  aria-pressed="<%= idx === _ei ? 'true' : 'false' %>"
                ><span class="project-logo-swatch-emoji"><%- emo %></span></button>
              <% }); %>
            </div>
            <p class="project-logo-popover-label">Color</p>
            <div class="project-logo-popover-row" role="group" aria-label="Background color">
              <% for (var c = 0; c < 12; c++) { %>
                <button
                  type="button"
                  class="project-logo-swatch project-logo-swatch--color<%= c === _ci ? ' is-selected' : '' %>"
                  data-logo-color="<%= c %>"
                  aria-label="Color <%= c + 1 %>"
                  aria-pressed="<%= c === _ci ? 'true' : 'false' %>"
                ><span class="project-logo-color-dot" data-logo-color="<%= c %>"></span></button>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="project-header-actions">
        <form method="post" action="/projects/<%= project.id %>/delete" class="delete-form project-delete-form">
          <button
            type="submit"
            class="project-delete-btn btn btn--ghost btn--sm header-action-btn"
            onclick="return confirm('Delete this project? Chats inside will detach (not deleted).')"
            aria-label="Delete project"
            title="Delete project"
          >
            <%- include('partials/header-tool-icon', { icon: 'delete' }) %>
            <span class="header-tool-label">Delete</span>
          </button>
        </form>
      </div>
    </header>

    <section class="project-body">
      <div class="project-body-inner">
        <nav class="project-tabs" role="tablist" aria-label="Project sections">
          <button
            type="button"
            class="project-tab is-active"
            role="tab"
            id="project-tab-team"
            aria-controls="project-panel-team"
            aria-selected="true"
            tabindex="0"
            data-project-tab="team"
            data-tab-base="Team"
          >Team</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-chats"
            aria-controls="project-panel-chats"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="chats"
            data-tab-base="Chats"
            data-tab-count="<%= projectChats.length %>"
          >Chats (<%= projectChats.length %>)</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-memory"
            aria-controls="project-panel-memory"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="memory"
            data-tab-base="Memory"
            data-tab-count="<%= facts.length %>"
          >Memory</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-skills"
            aria-controls="project-panel-skills"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="skills"
            data-tab-base="Skills"
            data-tab-count="<%= (skills || []).length %>"
          >Skills</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-links"
            aria-controls="project-panel-links"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="links"
            data-tab-base="Links"
            data-tab-count="<%= projectWebLinks.length %>"
          >Links</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-files"
            aria-controls="project-panel-files"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="files"
            data-tab-base="Files"
            data-tab-count="<%= projectFileLinks.length %>"
          >Files</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-secrets"
            aria-controls="project-panel-secrets"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="secrets"
            data-tab-base="Secrets"
            data-tab-count="<%= (projectSecrets || []).length %>"
          >Secrets</button>
          <% if (typeof hasAnyTasks !== 'undefined' && hasAnyTasks) { %>
          <a
            href="/tasks?projectId=<%= project.id %>"
            class="project-tab project-tab--tasks"
            id="project-tab-tasks"
          >Tasks</a>
          <% } %>
        </nav>

        <div
          id="project-panel-team"
          class="project-panel project-panel--active"
          role="tabpanel"
          aria-labelledby="project-tab-team"
        >
          <div class="project-sheet project-sheet--flush">
            <%
              var _specialists = (typeof characters !== 'undefined' ? characters : []).filter(function (c) { return c.id !== 'generalist'; });
              var _ptasks = (typeof projectTasks !== 'undefined' && Array.isArray(projectTasks)) ? projectTasks : [];
              function _statusLabel(s) {
                return ({ planning: 'Planning', ready: 'To do', running: 'Doing', needs_review: 'Needs review', needs_human: 'Needs you', needs_clarification: 'Needs you', done: 'Done', failed: 'Failed' })[s] || s;
              }
              function _statusClass(s) {
                if (s === 'running' || s === 'planning') return 'doing';
                if (s === 'needs_review') return 'review';
                if (s === 'needs_human' || s === 'needs_clarification') return 'needs-you';
                if (s === 'done') return 'done';
                if (s === 'failed') return 'failed';
                return 'todo';
              }
            %>
            <p class="team-tab-intro muted">Give each specialist a task. They work it in their own view — you review and approve.</p>
            <div class="team-grid">
              <% _specialists.forEach(function (ch) {
                   var mine = _ptasks.filter(function (t) { return t.character_id === ch.id; });
                   mine.sort(function (a, b) { return (b.id || 0) - (a.id || 0); });
                   var current = mine.length ? mine[0] : null;
              %>
              <div class="team-member" data-logo-color="<%= ch.color %>">
                <div class="team-member-head">
                  <%- include('partials/characterFace', { character: ch, faceClass: 'team-member-face' }) %>
                  <span class="team-member-id">
                    <span class="team-member-name"><%= ch.name %></span>
                    <span class="team-member-role"><%= ch.role %></span>
                  </span>
                </div>
                <% if (current) { %>
                <a class="team-member-task" href="/tasks/<%= current.id %>">
                  <span class="team-status team-status--<%= _statusClass(current.status) %>"><%= _statusLabel(current.status) %></span>
                  <span class="team-task-title"><%= current.title %></span>
                </a>
                <% if (mine.length > 1) { %>
                <a class="team-member-more" href="/tasks?projectId=<%= project.id %>"><%= mine.length %> tasks &rsaquo;</a>
                <% } %>
                <% } else { %>
                <p class="team-member-idle muted">Idle — give a task to start.</p>
                <% } %>
                <form class="team-assign" method="post" action="/projects/<%= project.id %>/team/<%= ch.id %>/tasks">
                  <input type="text" name="goal" class="team-assign-input" placeholder="Give <%= ch.name %> a task…" aria-label="Task for <%= ch.name %>" required />
                  <button type="submit" class="btn btn--primary btn--sm">Give task</button>
                </form>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <div
          id="project-panel-chats"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-chats"
          hidden
        >
          <div class="project-sheet project-sheet--flush">
            <% if (projectChats.length === 0) { %>
              <p class="project-empty-chats muted">No chats yet. Start one from the home screen while this project is selected.</p>
            <% } else { %>
              <ul class="project-chats">
                <% projectChats.forEach(function (c) { %>
                  <li>
                    <a href="/chats/<%= c.id %>" class="project-chat-link">
                      <span class="project-chat-title"><%= c.title %></span>
                      <span class="project-chat-tail">
                        <% if (c.shares_to_project === 0) { %>
                          <span class="project-chat-badge" title="Facts not suggested for project">Off</span>
                        <% } %>
                      </span>
                    </a>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>

        <div
          id="project-panel-memory"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-memory"
          hidden
        >
          <div class="project-sheet project-sheet--flush project-sheet--stacked">
            <ul id="facts-list" class="project-chats">
              <% facts.forEach(function (f) { %>
                <li class="fact" data-fact-id="<%= f.id %>">
                  <% if (f.source_chat_id) { %>
                    <div class="project-row-head muted">
                      <a href="/chats/<%= f.source_chat_id %>" class="project-chat-source"><%= (f.source_chat_title || '').trim() || 'Chat' %></a>
                    </div>
                  <% } else { %>
                    <div class="project-row-head muted"><span>—</span></div>
                  <% } %>
                  <textarea
                    class="fact-content"
                    aria-label="Fact text"
                    rows="2"
                  ><%= f.content %></textarea>
                  <div class="fact-meta">
                    <button
                      type="button"
                      class="fact-delete"
                      aria-label="Remove fact"
                    >Remove</button>
                  </div>
                </li>
              <% }); %>
              <% if (facts.length === 0) { %>
                <li class="project-chats-empty muted">No facts yet. Accept a suggestion in a chat for this project.</li>
              <% } %>
            </ul>
          </div>
        </div>

        <div
          id="project-panel-skills"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-skills"
          hidden
        >
          <div class="project-sheet project-sheet--flush project-sheet--stacked">
            <ul id="skills-list" class="project-chats">
              <% (skills || []).forEach(function (s) { %>
                <li class="skill" data-skill-id="<%= s.id %>" data-skill-version="<%= s.version %>">
                  <div class="project-row-head muted">
                    <% if (s.project_id === null) { %>
                      <span class="skill-scope-badge" title="Available to every project">Global</span>
                    <% } %>
                    <% if (s.source_chat_id) { %>
                      <a href="/chats/<%= s.source_chat_id %>" class="project-chat-source"><%= (s.source_chat_title || '').trim() || 'Chat' %></a>
                    <% } else { %>
                      <span>—</span>
                    <% } %>
                  </div>
                  <input
                    class="skill-name"
                    aria-label="Skill name"
                    value="<%= s.name %>"
                    spellcheck="false"
                  />
                  <textarea
                    class="skill-description"
                    aria-label="Skill summary"
                    rows="2"
                  ><%= s.description %></textarea>
                  <details class="skill-body-details">
                    <summary>View / edit procedure</summary>
                    <textarea
                      class="skill-body"
                      aria-label="Skill procedure (SKILL.md)"
                      rows="10"
                    ><%= s.body %></textarea>
                  </details>
                  <div class="fact-meta">
                    <button type="button" class="fact-delete skill-delete" aria-label="Remove skill">Remove</button>
                  </div>
                </li>
              <% }); %>
              <% if (!(skills || []).length) { %>
                <li class="project-chats-empty muted">No skills yet. Accept a skill suggestion in a chat for this project.</li>
              <% } %>
            </ul>
          </div>
        </div>

        <div
          id="project-panel-links"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-links"
          hidden
        >
          <div class="project-sheet project-sheet--flush">
            <% if (projectWebLinks.length === 0) { %>
              <p class="project-empty-chats muted">No links in this project's messages yet.</p>
            <% } else { %>
              <ul class="project-chats">
                <% projectWebLinks.forEach(function (entry) { %>
                  <li>
                    <div class="project-chat-link project-chat-link--stacked">
                      <div class="project-row-head muted">
                        <% entry.sources.forEach(function (s, i) { %>
                          <% if (i > 0) { %><span aria-hidden="true"> · </span><% } %>
                          <a href="/chats/<%= s.chatId %>" class="project-chat-source"><%= s.chatTitle %></a>
                        <% }); %>
                      </div>
                      <a
                        href="<%= entry.url %>"
                        class="project-row-element project-chat-title--url"
                        target="_blank"
                        rel="noopener noreferrer"
                      ><%= entry.url %></a>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>

        <div
          id="project-panel-files"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-files"
          hidden
        >
          <div class="project-sheet project-sheet--flush">
            <% if (projectFileLinks.length === 0) { %>
              <p class="project-empty-chats muted">No paths or file:// URLs in this project's messages yet.</p>
            <% } else { %>
              <ul class="project-chats">
                <% projectFileLinks.forEach(function (entry) { %>
                  <li>
                    <div
                      class="project-chat-link project-chat-link--stacked project-chat-link--path"
                      title="<%= entry.kind === 'file' ? 'file:// — browsers usually cannot open this from an http page.' : 'Path from chat — for copying; browsers cannot open local paths directly.' %>"
                    >
                      <div class="project-row-head muted">
                        <% entry.sources.forEach(function (s, i) { %>
                          <% if (i > 0) { %><span aria-hidden="true"> · </span><% } %>
                          <a href="/chats/<%= s.chatId %>" class="project-chat-source"><%= s.chatTitle %></a>
                        <% }); %>
                      </div>
                      <span class="project-row-element project-file-line"><%= entry.url %></span>
                    </div>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>

        <div
          id="project-panel-secrets"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-secrets"
          hidden
        >
          <div class="project-sheet project-sheet--flush project-sheet--stacked">
            <ul id="secrets-list" class="project-chats">
              <% (projectSecrets || []).forEach(function (s) { %>
                <% var spoilerCh = Math.max(Number(s.value_length) || 0, String(s.label || '').length, 4); %>
                <li class="project-secret-row" data-secret-id="<%= s.id %>">
                  <div class="project-chat-link project-chat-link--stacked project-secret-card">
                    <span class="project-chat-title project-secret-title"><%= s.label %></span>
                    <button
                      type="button"
                      class="project-secret-reveal iclaw-secret-spoiler-body project-secret-spoiler-preview"
                      data-secret-len="<%= spoilerCh %>"
                      style="--secret-len-ch:<%= spoilerCh %>"
                      aria-label="Show secret value"
                    ><span class="iclaw-secret-spoiler-grain" aria-hidden="true"></span></button>
                  </div>
                </li>
              <% }); %>
              <% if (!(projectSecrets || []).length) { %>
                <li class="project-chats-empty muted">No saved secrets yet</li>
              <% } %>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/iclaw.js?v=1"></script>
  </main>
</div>

<%- include('partials/foot') %>
