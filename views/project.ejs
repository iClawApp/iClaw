<%- include('partials/head', { title: project.name + ' — iClaw' }) %>
<% const _ei = (function () {
  const n = Number(project.logo_emoji);
  const em = Array.isArray(projectLogoEmojis) ? projectLogoEmojis : [];
  const max = em.length ? em.length - 1 : 9;
  if (!Number.isFinite(n) || n < 0) return 0;
  if (n > max) return max;
  return Math.floor(n);
})(); %>
<% const _ci = (function () {
  const n = Number(project.logo_color);
  if (!Number.isFinite(n) || n < 0) return 0;
  if (n > 9) return 9;
  return Math.floor(n);
})(); %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main project-page" data-project-id="<%= project.id %>">
    <header class="chat-header project-header">
      <div class="project-header-primary">
        <div class="project-title-cluster">
          <button
            type="button"
            class="project-logo-trigger"
            id="project-logo-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Change project icon and color"
          >
            <%- include('partials/projectLogo', { emojiIndex: _ei, colorIndex: _ci }) %>
          </button>
          <form
            method="post"
            action="/projects/<%= project.id %>/rename"
            class="rename-form project-title-form"
            id="project-rename-form"
          >
            <input
              type="text"
              name="name"
              value="<%= project.name %>"
              aria-label="Project name"
              placeholder="Name"
            />
          </form>

          <div id="project-logo-popover" class="project-logo-popover" hidden>
            <p class="project-logo-popover-label">Emoji</p>
            <div class="project-logo-popover-row" role="group" aria-label="Emoji">
              <% (projectLogoEmojis || []).forEach(function (emo, idx) { %>
                <button
                  type="button"
                  class="project-logo-swatch project-logo-swatch--emoji<%= idx === _ei ? ' is-selected' : '' %>"
                  data-logo-emoji="<%= idx %>"
                  aria-label="Emoji <%= idx + 1 %>"
                  aria-pressed="<%= idx === _ei ? 'true' : 'false' %>"
                ><span class="project-logo-swatch-emoji"><%- emo %></span></button>
              <% }); %>
            </div>
            <p class="project-logo-popover-label">Color</p>
            <div class="project-logo-popover-row" role="group" aria-label="Background color">
              <% for (var c = 0; c < 10; c++) { %>
                <button
                  type="button"
                  class="project-logo-swatch project-logo-swatch--color<%= c === _ci ? ' is-selected' : '' %>"
                  data-logo-color="<%= c %>"
                  aria-label="Color <%= c + 1 %>"
                  aria-pressed="<%= c === _ci ? 'true' : 'false' %>"
                ><span class="project-logo-color-dot" data-logo-color="<%= c %>"></span></button>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="project-header-actions">
        <form method="post" action="/projects/<%= project.id %>/delete" class="delete-form project-delete-form">
          <button
            type="submit"
            class="project-delete-btn"
            onclick="return confirm('Delete this project? Chats inside will detach (not deleted).')"
            aria-label="Delete project"
          >Delete</button>
        </form>
      </div>
    </header>

    <section class="project-body">
      <div class="project-body-inner">
        <nav class="project-tabs" role="tablist" aria-label="Розділи проєкту">
          <button
            type="button"
            class="project-tab is-active"
            role="tab"
            id="project-tab-chats"
            aria-controls="project-panel-chats"
            aria-selected="true"
            tabindex="0"
            data-project-tab="chats"
          >Чати</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-memory"
            aria-controls="project-panel-memory"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="memory"
          >Памʼять</button>
          <button
            type="button"
            class="project-tab"
            role="tab"
            id="project-tab-links"
            aria-controls="project-panel-links"
            aria-selected="false"
            tabindex="-1"
            data-project-tab="links"
          >Посилання</button>
        </nav>

        <div
          id="project-panel-chats"
          class="project-panel project-panel--active"
          role="tabpanel"
          aria-labelledby="project-tab-chats"
        >
          <section class="project-section" aria-labelledby="project-chats-label">
            <div class="project-section-head">
              <h2 class="project-section-label" id="project-chats-label">Чати</h2>
              <span class="project-section-count"><%= projectChats.length %></span>
            </div>
            <div class="project-sheet project-sheet--flush">
              <% if (projectChats.length === 0) { %>
                <p class="project-empty-chats muted">Ще немає чатів. Почніть чат з головної, коли обрано цей проєкт.</p>
              <% } else { %>
                <ul class="project-chats">
                  <% projectChats.forEach(function (c) { %>
                    <li>
                      <a href="/chats/<%= c.id %>" class="project-chat-link">
                        <span class="project-chat-title"><%= c.title %></span>
                        <span class="project-chat-tail">
                          <% if (c.shares_to_project === 0) { %>
                            <span class="project-chat-badge" title="Не пропонує факти в проєкт">Вимк.</span>
                          <% } %>
                          <span class="project-chat-chevron" aria-hidden="true"></span>
                        </span>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </section>
        </div>

        <div
          id="project-panel-memory"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-memory"
          hidden
        >
          <p class="project-page-intro muted">
            Факти з чатів (рядок з пропозицією → ✓) зʼявляються тут і додаються до нових повідомлень у цьому проєкті.
          </p>
          <section class="project-section" aria-labelledby="project-facts-label">
            <div class="project-section-head">
              <h2 class="project-section-label" id="project-facts-label">Спільний контекст</h2>
              <span class="project-section-count" id="facts-count" aria-live="polite"><%= facts.length %></span>
            </div>
            <p class="project-section-footnote muted">
              Можна відредагувати текст або прибрати рядок; нові факти лише з чатів.
            </p>
            <div class="project-sheet project-sheet--stacked">
              <ul class="facts-list" id="facts-list">
                <% facts.forEach(function (f) { %>
                  <li class="fact" data-fact-id="<%= f.id %>">
                    <textarea
                      class="fact-content"
                      aria-label="Текст факту"
                      rows="2"
                    ><%= f.content %></textarea>
                    <div class="fact-meta">
                      <% if (f.source_chat_id) { %>
                        <a href="/chats/<%= f.source_chat_id %>" class="fact-source">
                          Чат #<%= f.source_chat_id %>
                        </a>
                      <% } %>
                      <button
                        type="button"
                        class="fact-delete"
                        aria-label="Видалити факт"
                      >Прибрати</button>
                    </div>
                  </li>
                <% }); %>
                <% if (facts.length === 0) { %>
                  <li class="facts-empty muted">Поки немає фактів. Підтвердіть пропозицію в чаті цього проєкту.</li>
                <% } %>
              </ul>
            </div>
          </section>
        </div>

        <div
          id="project-panel-links"
          class="project-panel"
          role="tabpanel"
          aria-labelledby="project-tab-links"
          hidden
        >
          <section class="project-section" aria-labelledby="project-links-label">
            <div class="project-section-head">
              <h2 class="project-section-label" id="project-links-label">Посилання</h2>
              <span class="project-section-count"><%= projectLinks.length %></span>
            </div>
            <p class="project-section-footnote muted">
              Зібрано з повідомлень усіх чатів цього проєкту (http/https).
            </p>
            <div class="project-sheet project-sheet--flush">
              <% if (projectLinks.length === 0) { %>
                <p class="project-links-empty muted">Поки немає посилань у повідомленнях цього проєкту.</p>
              <% } else { %>
                <ul class="project-links-list">
                  <% projectLinks.forEach(function (entry) { %>
                    <li class="project-link-item">
                      <a href="<%= entry.url %>" target="_blank" rel="noopener noreferrer" class="project-link-url"><%= entry.url %></a>
                      <div class="project-link-sources muted">
                        <% entry.sources.forEach(function (s, i) { %>
                          <% if (i > 0) { %><span aria-hidden="true"> · </span><% } %>
                          <a href="/chats/<%= s.chatId %>" class="project-link-chat"><%= s.chatTitle %></a>
                        <% }); %>
                      </div>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </section>
        </div>
      </div>
    </section>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/iclaw.js"></script>
  </main>
</div>

<%- include('partials/foot') %>
