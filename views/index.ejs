<%- include('partials/head', { title: 'iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main">
    <header class="chat-header draft-header">
      <%- include('partials/mobile-nav-toggle') %>
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="New chat"
          aria-label="Chat title"
          disabled
        />
      </form>

      <div class="chat-header-tools">
      <form class="agent-form header-field" onsubmit="return false">
        <label class="header-field-label" for="draft-agent">Agent</label>
        <select id="draft-agent" aria-label="Agent">
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= defaultAgent %>" selected><%= defaultAgent %></option>
          <% } else { %>
            <% agents.forEach(function (a) { %>
              <option value="<%= a.id %>" <%= a.id === defaultAgent ? 'selected' : '' %>>
                <%= a.id %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </form>

      <button
        type="button"
        class="stop-btn btn btn--ghost btn--sm header-action-btn"
        id="stop-btn"
        aria-label="Stop generation"
        title="Stop this turn"
        hidden
      >
        <%- include('partials/header-tool-icon', { icon: 'stop' }) %>
        <span class="header-tool-label">Stop</span>
      </button>

      <span
        class="gateway <%= gatewayStatus %>"
        id="gateway-badge"
        data-base-url="<%= openclawBaseUrl %>"
        title="<%= openclawBaseUrl %>"
      >
        OpenClaw: <%= gatewayStatus === 'ok' ? 'connected' : (gatewayStatus === 'degraded' ? 'unreachable' : 'off') %>
      </span>
      </div>
    </header>

    <div
      class="draft-body is-picking"
      id="draft-body"
    >
      <div class="draft-pick-stage" id="draft-pick-stage">
        <% if (agentsError) { %>
        <%- include('partials/gatewayError', { agentsError, gatewayUp, openclawBaseUrl }) %>
        <% } else { %>
        <section
          class="project-pick"
          id="project-pick"
          role="region"
          aria-labelledby="project-pick-title"
          data-initial-project-id="<%= preselectedProject ? String(preselectedProject.id) : '' %>"
        >
          <h2 class="project-pick-title" id="project-pick-title">Choose a project</h2>
          <div class="project-pick-grid">
            <button
              type="button"
              class="project-pick-card project-pick-card--none"
              data-project-id=""
              data-project-name="No project"
            >
              <span class="project-pick-card-inner">
                <span class="project-logo project-logo--none" data-logo-color="0" aria-hidden="true">💬</span>
                <span class="project-pick-name">No project</span>
              </span>
            </button>
            <% allProjects.forEach(function (p) {
              const _ei = typeof p.logo_emoji === 'number' ? p.logo_emoji : 0;
              const _ci = typeof p.logo_color === 'number' ? p.logo_color : 0;
            %>
            <button
              type="button"
              class="project-pick-card"
              data-project-id="<%= p.id %>"
              data-project-name="<%= p.name %>"
            >
              <span class="project-pick-card-inner">
                <%- include('partials/projectLogo', { emojiIndex: _ei, colorIndex: _ci }) %>
                <span class="project-pick-name"><%= p.name %></span>
              </span>
            </button>
            <% }); %>
          </div>
        </section>
        <% } %>
      </div>

      <section class="messages" id="messages" data-chat-id="" data-draft="1">
        <div class="messages-thread">
          <p class="muted empty-state" id="draft-empty-hint" hidden>Write your first message.</p>
        </div>
      </section>

      <section class="queue" id="queue" aria-live="polite"></section>

      <% if (!agentsError) { %>
      <div id="draft-composer-wrap" class="draft-composer-wrap" hidden>
        <%- include('partials/composer') %>
      </div>
      <% } %>
    </div>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/vendor/highlight.min.js"></script>
    <script src="/js/iclaw.js"></script>
  </main>
</div>

<%- include('partials/foot') %>
