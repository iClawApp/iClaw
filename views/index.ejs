<%- include('partials/head', { title: 'iClaude' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main">
    <header class="chat-header">
      <h1>iClaude</h1>
      <span class="gateway <%= gatewayUp ? 'ok' : 'down' %>" title="<%= openclawBaseUrl %>">
        OpenClaw: <%= gatewayUp ? 'connected' : 'unreachable' %>
      </span>
    </header>

    <section class="welcome">
      <h2>Start a new chat</h2>
      <% if (agentsError) { %>
        <p class="error">Gateway unreachable: <code><%= agentsError %></code></p>
      <% } else { %>
        <form method="post" action="/chats" class="stack">
          <label>
            Agent
            <select name="agent">
              <% agents.forEach(function (a) { %>
                <option value="<%= a.id %>" <%= a.id === defaultAgent ? 'selected' : '' %>>
                  <%= a.id %>
                </option>
              <% }); %>
            </select>
          </label>
          <button type="submit">New chat</button>
        </form>
      <% } %>
    </section>
  </main>
</div>

<%- include('partials/foot') %>
