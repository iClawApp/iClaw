<%- include('partials/head', { title: 'iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main">
    <header class="chat-header draft-header">
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="New chat"
          aria-label="Chat title"
          disabled
        />
      </form>

      <form class="agent-form header-field" onsubmit="return false">
        <label class="header-field-label" for="draft-agent">Agent</label>
        <select id="draft-agent" aria-label="Agent">
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= defaultAgent %>" selected><%= defaultAgent %></option>
          <% } else { %>
            <% agents.forEach(function (a) { %>
              <option value="<%= a.id %>" <%= a.id === defaultAgent ? 'selected' : '' %>>
                <%= a.id %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </form>

      <form class="project-form header-field" onsubmit="return false">
        <label class="header-field-label" for="draft-project">Project</label>
        <select id="draft-project" aria-label="Project">
          <option value="">(no project)</option>
          <% allProjects.forEach(function (p) { %>
            <option value="<%= p.id %>" <%= preselectedProject && preselectedProject.id === p.id ? 'selected' : '' %>>
              <%= p.name %>
            </option>
          <% }); %>
        </select>
      </form>

      <span class="gateway <%= gatewayUp ? 'ok' : 'down' %>" title="<%= openclawBaseUrl %>">
        OpenClaw: <%= gatewayUp ? 'connected' : 'unreachable' %>
      </span>
    </header>

    <section class="messages" id="messages" data-chat-id="" data-draft="1">
      <% if (agentsError) { %>
        <p class="error">Gateway unreachable: <code><%= agentsError %></code></p>
      <% } else if (preselectedProject) { %>
        <p class="muted empty-state">
          New chat in <strong><%= preselectedProject.name %></strong>.
          Type a message to start.
        </p>
      <% } else { %>
        <p class="muted empty-state">Type a message to start a new chat.</p>
      <% } %>
    </section>

    <section class="queue" id="queue" aria-live="polite"></section>

    <%- include('partials/composer') %>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/iclaw.js"></script>
  </main>
</div>

<%- include('partials/foot') %>
