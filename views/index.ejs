<%- include('partials/head', { title: 'iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main">
    <header class="chat-header draft-header">
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="New chat"
          aria-label="Chat title"
          disabled
        />
      </form>

      <form class="agent-form" onsubmit="return false">
        <select id="draft-agent" aria-label="Agent">
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= defaultAgent %>" selected><%= defaultAgent %></option>
          <% } else { %>
            <% agents.forEach(function (a) { %>
              <option value="<%= a.id %>" <%= a.id === defaultAgent ? 'selected' : '' %>>
                <%= a.id %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </form>

      <span class="gateway <%= gatewayUp ? 'ok' : 'down' %>" title="<%= openclawBaseUrl %>">
        OpenClaw: <%= gatewayUp ? 'connected' : 'unreachable' %>
      </span>
    </header>

    <section class="messages" id="messages" data-chat-id="" data-draft="1">
      <% if (agentsError) { %>
        <p class="error">Gateway unreachable: <code><%= agentsError %></code></p>
      <% } else { %>
        <p class="muted empty-state">Type a message to start a new chat.</p>
      <% } %>
    </section>

    <section class="queue" id="queue" aria-live="polite"></section>

    <form id="send-form" class="composer">
      <textarea
        id="composer-input"
        name="content"
        placeholder="Message the agent… (Enter to send, Shift+Enter for newline)"
        rows="2"
        required
      ></textarea>
      <button type="submit">Send</button>
    </form>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/chat.js"></script>
  </main>
</div>

<%- include('partials/foot') %>
