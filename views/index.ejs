<%- include('partials/head', { title: 'iClaw' }) %>

<div class="app app--solo">
  <main class="col col-main">
    <header class="chat-header draft-header chat-header--with-switcher">
      <div class="chat-header-left">
      <%- include('partials/mobile-nav-toggle') %>
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="iClaw"
          aria-label="Chat title"
          disabled
        />
      </form>
      </div>

      <%# On the launcher (not yet in a chat) the project chooser sits at the top
          centre — pick which project the new chat belongs to. Syncs with the
          drawer's switcher (same data-drawer-project chips). %>
      <div class="chat-header-center">
        <%- include('partials/projectSwitcher', {
              switcherProjects: typeof drawerProjects !== 'undefined' ? drawerProjects : (typeof allProjects !== 'undefined' ? allProjects : []),
              switcherActiveId: typeof drawerProjectId !== 'undefined' ? drawerProjectId : null,
            }) %>
      </div>

      <div class="chat-header-tools">
      <form class="agent-form header-field" onsubmit="return false">
        <label class="header-field-label" for="draft-agent">Agent</label>
        <select id="draft-agent" aria-label="Agent">
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= defaultAgent %>" selected><%= defaultAgent %></option>
          <% } else { %>
            <% agents.forEach(function (a) { %>
              <option value="<%= a.id %>" <%= a.id === defaultAgent ? 'selected' : '' %>>
                <%= a.id %>
              </option>
            <% }); %>
          <% } %>
        </select>
      </form>

      <%- include('partials/header-chat-tools', { draftHeader: true }) %>

      </div>
    </header>

    <% const _firstChat = typeof isFirstChat !== 'undefined' && isFirstChat; %>
    <% const _noProjects = !Array.isArray(allProjects) || allProjects.length === 0; %>
    <div
      class="draft-body is-picking is-launcher"
      id="draft-body"
      data-auto-none="1"
    >
      <div class="draft-pick-stage" id="draft-pick-stage">
        <%# No model connected (skipped onboarding, no OpenClaw) is no longer a
            dead end here — we show the normal picker + composer and re-offer the
            connect choice when the user actually tries to send (connectModal). %>
        <section
          class="project-pick"
          id="project-pick"
          role="region"
          aria-labelledby="project-pick-title"
          data-initial-project-id="<%= preselectedProject ? String(preselectedProject.id) : '' %>"
        >
          <h2 class="project-pick-title" id="project-pick-title">Choose a project</h2>
          <p class="project-pick-hint">Press Space to select <button type="button" class="project-pick-hint-none" id="project-pick-hint-none" aria-pressed="false">No project</button></p>
          <div class="project-pick-grid">
            <button
              type="button"
              class="project-pick-card project-pick-card--none"
              data-project-id=""
              data-project-name="No project"
            >
              <span class="project-pick-card-inner">
                <span class="project-logo project-logo--none" data-logo-color="0" aria-hidden="true">💬</span>
                <span class="project-pick-name">No project</span>
              </span>
            </button>
            <% allProjects.forEach(function (p) {
              const _ei = typeof p.logo_emoji === 'number' ? p.logo_emoji : 0;
              const _ci = typeof p.logo_color === 'number' ? p.logo_color : 0;
            %>
            <button
              type="button"
              class="project-pick-card"
              data-project-id="<%= p.id %>"
              data-project-name="<%= p.name %>"
            >
              <span class="project-pick-card-inner">
                <%- include('partials/projectLogo', { emojiIndex: _ei, colorIndex: _ci }) %>
                <span class="project-pick-name"><%= p.name %></span>
              </span>
            </button>
            <% }); %>
          </div>
        </section>
      </div>

      <section class="messages" id="messages" data-chat-id="" data-draft="1">
        <div class="messages-thread is-launcher"></div>
      </section>

      <section class="queue" id="queue" aria-live="polite"></section>

      <div id="draft-composer-wrap" class="draft-composer-wrap" hidden>
        <%- include('partials/composer', { gatewayOk: gatewayStatus === 'ok' }) %>
      </div>

      <%# Teammate strip — sits below the centred composer on the launcher; CSS
          hides it once a chat starts. %>
      <%- include('partials/chatRoster', { characters: typeof characters !== 'undefined' ? characters : [] }) %>

      <%# Recents for the selected project, directly under the roster. Swapped in
          place (no reload) when the launcher's project changes — see
          refreshLauncherChats / GET /api/launcher-chats. %>
      <div id="launcher-chats-wrap" class="launcher-chats-wrap">
        <%- include('partials/launcherChats', {
              launcherChats: typeof drawerChats !== 'undefined' ? drawerChats : [],
              launcherProjectName: preselectedProject ? preselectedProject.name : null,
              launcherCharacters: typeof characters !== 'undefined' ? characters : [],
              launcherWorkingIds: typeof workingIds !== 'undefined' ? workingIds : [],
            }) %>
      </div>
    </div>

    <% if (cloudShareBaseUrl) { %>
      <%- include('partials/share-modal') %>
    <% } %>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/vendor/highlight.min.js"></script>
    <script src="/js/iclaw.js?v=1"></script>
    <% if (cloudShareBaseUrl) { %>
      <script src="/js/share.js" defer></script>
    <% } %>
  </main>

  <%# Slide-out menu: every agent's chats in this project + a project switcher. %>
  <%- include('partials/projectDrawer', {
        drawerProjectId: typeof drawerProjectId !== 'undefined' ? drawerProjectId : null,
        drawerProjects: typeof drawerProjects !== 'undefined' ? drawerProjects : (typeof allProjects !== 'undefined' ? allProjects : []),
        drawerCharacters: typeof drawerCharacters !== 'undefined' ? drawerCharacters : [],
        drawerChats: typeof drawerChats !== 'undefined' ? drawerChats : [],
        drawerActiveChatId: typeof drawerActiveChatId !== 'undefined' ? drawerActiveChatId : 0,
        drawerWorkingIds: typeof drawerWorkingIds !== 'undefined' ? drawerWorkingIds : [],
      }) %>
</div>

<%- include('partials/foot') %>
