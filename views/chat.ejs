<%- include('partials/head', { title: activeChat.title + ' — iClaw' }) %>

<% var _isSpec = (typeof character !== 'undefined' && character && character.id !== 'generalist'); %>
<div class="app">
  <% if (_isSpec) { %>
    <%- include('partials/specialistSidebar', { character: character, specialistProject: (typeof specialistProject !== 'undefined' ? specialistProject : null), specialistChats: (typeof specialistChats !== 'undefined' ? specialistChats : []), activeChat: activeChat }) %>
  <% } else { %>
    <%- include('partials/sidebar') %>
  <% } %>

  <main class="col col-main<%= _isSpec ? ' specialist-main' : '' %>"<% if (_isSpec) { %> data-logo-color="<%= character.color %>"<% } %>>
    <header class="chat-header">
      <%- include('partials/mobile-nav-toggle') %>
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="<%= activeChat.title %>"
          aria-label="Chat title"
        />
      </form>
      <% if (typeof devMode !== 'undefined' && devMode) { const _tokTotal = (chatMessages || []).reduce((a, m) => a + (Number(m.tokens) || 0), 0); %>
        <span class="chat-token-total" id="chat-token-total" data-total="<%= _tokTotal %>"
          title="Total tokens spent in this chat (dev mode)" <%= _tokTotal > 0 ? '' : 'hidden' %>><%= _tokTotal.toLocaleString() %> tok total</span>
      <% } %>

      <div class="chat-header-tools">
      <form class="agent-form header-field" method="post" action="/chats/<%= activeChat.id %>/agent">
        <label class="header-field-label" for="chat-agent-select">Agent</label>
        <select name="agent" id="chat-agent-select" onchange="this.form.requestSubmit()" aria-label="Agent">
          <% agents.forEach(function (a) { %>
            <option value="<%= a.id %>" <%= a.id === activeChat.agent ? 'selected' : '' %>>
              <%= a.id %>
            </option>
          <% }); %>
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= activeChat.agent %>" selected><%= activeChat.agent %></option>
          <% } %>
        </select>
      </form>

      <%- include('partials/header-chat-tools') %>
      </div>
    </header>

    <%# Specialist power-up: the agent's panel (calendar / saved replies), tucked
        away and opened on demand from the sidebar power-up button. %>
    <% if (_isSpec && character.panel) { %>
    <div class="specialist-panel-overlay" id="specialist-panel" hidden>
      <div class="specialist-panel-sheet">
        <button type="button" class="specialist-panel-close" data-close-panel aria-label="Close">&times;</button>
        <% if (character.panel === 'calendar') { %>
        <%- include('partials/panelCalendar', { panelKey: 'chat-' + activeChat.id }) %>
        <% } else if (character.panel === 'replies') { %>
        <%- include('partials/panelReplies', { panelKey: 'chat-' + activeChat.id }) %>
        <% } %>
      </div>
    </div>
    <script>
      (function () {
        var ov = document.getElementById('specialist-panel');
        if (!ov) return;
        document.querySelectorAll('[data-open-panel]').forEach(function (b) {
          b.addEventListener('click', function () { ov.hidden = false; });
        });
        ov.querySelectorAll('[data-close-panel]').forEach(function (b) {
          b.addEventListener('click', function () { ov.hidden = true; });
        });
        ov.addEventListener('click', function (e) { if (e.target === ov) ov.hidden = true; });
      })();
    </script>
    <% } %>

    <%# Project "Brain" — shared memory (facts + skills). Not shown in a specialist
        chat (the agent already reads project memory; the panel just adds noise). %>
    <% if (!_isSpec && typeof activeChat !== 'undefined' && activeChat && activeChat.project_id != null) { %>
      <%- include('partials/brainPanel', {
            brainFacts: typeof brainFacts !== 'undefined' ? brainFacts : [],
            brainSkills: typeof brainSkills !== 'undefined' ? brainSkills : [],
            projectId: activeChat.project_id,
            chatId: activeChat.id,
          }) %>
    <% } %>

    <aside
      class="iclaw-inline-banner iclaw-inline-banner--warn card"
      id="reset-policy-banner"
      role="status"
      aria-live="polite"
      hidden
    >
      <div class="iclaw-inline-banner__main">
        <div class="iclaw-inline-banner__body" id="reset-policy-banner-body">
          <p class="iclaw-inline-banner__lead">Chat context resets daily at 04:00.</p>
          <p class="iclaw-inline-banner__detail">
            This is the OpenClaw default — after 4 AM the next day the agent forgets older chats.
            Change this behavior?
          </p>
        </div>
      </div>
      <div class="iclaw-inline-banner__actions" id="reset-policy-banner-actions">
        <button
          type="button"
          class="btn btn--primary btn--sm"
          id="reset-policy-fix"
        >Yes, configure</button>
        <button
          type="button"
          class="btn btn--ghost btn--sm"
          id="reset-policy-snooze"
          title="Do not show for 3 days"
        >Remind me in 3 days</button>
      </div>
    </aside>

    <div id="reset-policy-confirm" class="reset-policy-confirm" hidden>
      <div class="reset-policy-confirm__backdrop" id="reset-policy-confirm-backdrop"></div>
      <div
        class="reset-policy-confirm__panel card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="reset-policy-confirm-title"
      >
        <h3 class="reset-policy-confirm__title" id="reset-policy-confirm-title">Are you sure?</h3>
        <p class="reset-policy-confirm__detail muted">
          After 4&nbsp;AM tomorrow, iClaw will forget this chat&rsquo;s context unless you change the setting.
        </p>
        <div class="reset-policy-confirm__actions">
          <button type="button" class="btn btn--ghost btn--sm" id="reset-policy-confirm-cancel">Cancel</button>
          <button type="button" class="btn btn--primary btn--sm" id="reset-policy-confirm-ok">Remind me in 3 days</button>
        </div>
      </div>
    </div>

    <section
      class="messages"
      id="messages"
      data-chat-id="<%= activeChat.id %>"
      data-project-id="<%= activeChat.project_id != null ? activeChat.project_id : '' %>"
      data-defer-paint="1"
    >
      <div class="messages-thread">
        <% if (chatMessages.length === 0) { %>
          <% if (!Array.isArray(allProjects) || allProjects.length === 0) { %>
          <%- include('partials/welcomeCard') %>
          <% } else { %>
          <p class="muted empty-state">iClaw - the safer way to work with powerful AI</p>
          <% } %>
        <% } else { %>
          <% chatMessages.forEach(function (m) { %>
            <div class="msg <%= m.role %>" data-msg-id="<%= m.id %>">
              <div class="role"><%= m.role %></div>
              <% if (m.reply_to_message_id && m.reply_quote) { %>
                <%
                  const _rr = m.reply_to_role || '';
                  const _who = _rr === 'user' ? 'You' : (_rr === 'assistant' ? 'Assistant' : 'Chat');
                %>
                <button
                  type="button"
                  class="msg-reply-stub"
                  data-jump-to-msg="<%= m.reply_to_message_id %>"
                  data-reply-quote="<%= encodeURIComponent(m.reply_quote) %>"
                  aria-label="Jump to quoted message"
                >
                  <span class="msg-reply-stub-track">
                    <span class="msg-reply-stub-bar" aria-hidden="true"></span>
                    <span class="msg-reply-stub-body">
                      <span class="msg-reply-stub-label"><%= _who %></span>
                      <span class="msg-reply-stub-quote"><%= m.reply_quote %></span>
                    </span>
                  </span>
                </button>
              <% } %>
              <div class="msg-body"><%= m.content %></div>
              <% if (Array.isArray(m.attachments) && m.attachments.length > 0) { %>
                <div class="msg-attachments">
                  <% m.attachments.forEach(function (a) {
                    const _mime = String(a.mimeType || '');
                    const _url = String(a.url || '');
                    const _name = String(a.fileName || 'file');
                    const _sz = Number(a.sizeBytes) || 0;
                    function _humanSize(b){ if(b<1024)return b+' B'; if(b<1024*1024)return (b/1024).toFixed(1)+' KB'; return (b/(1024*1024)).toFixed(1)+' MB'; }
                  %>
                    <% if (_mime.indexOf('image/') === 0) { %>
                      <a class="msg-attachment" href="<%= _url %>" target="_blank" rel="noopener noreferrer">
                        <img class="msg-attachment-image" src="<%= _url %>" alt="<%= _name %>" loading="lazy" />
                      </a>
                    <% } else { %>
                      <a class="msg-attachment-file" href="<%= _url %>" target="_blank" rel="noopener noreferrer" title="<%= _name %>">
                        <span class="msg-attachment-file-name"><%= _name %></span>
                        <% if (_sz > 0) { %>
                          <span class="msg-attachment-file-size"><%= _humanSize(_sz) %></span>
                        <% } %>
                      </a>
                    <% } %>
                  <% }); %>
                </div>
              <% } %>
              <%# Tool trace UI is dev-only for now; the trace itself is always persisted (compaction/seed needs it). %>
              <% if (typeof devMode !== 'undefined' && devMode && m.role === 'assistant' && Array.isArray(m.tool_trace) && m.tool_trace.length > 0) { %>
                <% const _failed = m.tool_trace.filter(function (t) { return !t.ok; }).length; %>
                <details class="msg-tool-trace">
                  <summary><%= m.tool_trace.length %> tool call<%= m.tool_trace.length === 1 ? '' : 's' %><% if (_failed > 0) { %> · <span class="tt-failed"><%= _failed %> failed</span><% } %></summary>
                  <ul>
                    <% m.tool_trace.forEach(function (t) { %>
                      <%# Row: tool name + request target; ✗ only on failures. Full args → verdict in the tooltip. The `cd … && ` shell prefix is display noise — the target is the command after it. %>
                      <% const _tip = [t.detail, t.outcome].filter(Boolean).join(' → '); %>
                      <% const _target = (t.detail || '').replace(/^(cd [^&|;]+ && )+/, ''); %>
                      <li class="<%= t.ok ? 'tt-ok' : 'tt-err' %>"<% if (_tip) { %> title="<%= _tip %>"<% } %>>
                        <% if (!t.ok) { %><span class="tt-mark">✗</span><% } %>
                        <span class="tt-name"><%= t.name %></span>
                        <% if (_target) { %><span class="tt-detail"><%= _target %></span><% } %>
                      </li>
                    <% }); %>
                  </ul>
                </details>
              <% } %>
              <% if (typeof devMode !== 'undefined' && devMode && m.tokens) { %>
                <span class="msg-tokens" title="Tokens spent on this reply"><%= Number(m.tokens).toLocaleString() %> tok<% if (m.cached_tokens) { %> · <%= Number(m.cached_tokens).toLocaleString() %> cached<% } %></span>
              <% } %>
            </div>
          <% }); %>
        <% } %>
        <% if (isWorking) { %>
          <%
            // Activity persists across page reloads — server side state. The
            // client's WS connection picks up live events after subscribing.
            const _act = currentActivity || { kind: 'thinking', label: 'Thinking…' };
            const _waitingClass = _act.kind === 'tool' || _act.kind === 'lifecycle'
              ? 'stream-tool'
              : (_act.kind === 'generating' ? 'stream-generating' : 'stream-waiting');
            const _detail = _act.kind === 'tool' && _act.detail && _act.detail !== _act.label
              ? _act.detail
              : '';
          %>
          <div class="msg assistant streaming <%= _waitingClass %>" id="reload-placeholder">
            <div class="role">assistant</div>
            <div class="msg-body stream-body"></div>
            <div
              class="stream-status<%= _detail ? ' has-detail' : '' %>"
              <% if (_detail) { %>
                data-detail="<%= _detail %>"
                data-label="<%= _act.label %>"
                title="<%= _detail %>"
              <% } %>
            ><%= _act.label %></div>
          </div>
        <% } %>
      </div>
    </section>

    <%- include('partials/composer') %>

    <% if (cloudShareBaseUrl) { %>
      <%- include('partials/share-modal') %>
    <% } %>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/vendor/highlight.min.js"></script>
    <script>
      window.__ICLAW_QUEUE__ = <%- JSON.stringify(typeof queueList !== 'undefined' ? queueList : []) %>;
    </script>
    <script src="/js/iclaw.js?v=1"></script>
    <% if (cloudShareBaseUrl) { %>
      <script src="/js/share.js" defer></script>
    <% } %>
  </main>
</div>

<%- include('partials/foot') %>
