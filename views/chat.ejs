<%- include('partials/head', { title: activeChat.title + ' — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main">
    <header class="chat-header">
      <form class="rename-form" id="chat-rename-form" onsubmit="return false">
        <input
          type="text"
          id="chat-title-input"
          value="<%= activeChat.title %>"
          aria-label="Chat title"
        />
      </form>

      <form class="agent-form header-field" method="post" action="/chats/<%= activeChat.id %>/agent">
        <label class="header-field-label" for="chat-agent-select">Agent</label>
        <select name="agent" id="chat-agent-select" onchange="this.form.submit()" aria-label="Agent">
          <% agents.forEach(function (a) { %>
            <option value="<%= a.id %>" <%= a.id === activeChat.agent ? 'selected' : '' %>>
              <%= a.id %>
            </option>
          <% }); %>
          <% if (agentsError && agents.length === 0) { %>
            <option value="<%= activeChat.agent %>" selected><%= activeChat.agent %></option>
          <% } %>
        </select>
      </form>

      <label
        class="reasoning-toggle header-field"
        title="Show the model's reasoning / thinking inline. Type /reasoning on in chat to actually enable it on OpenClaw side."
      >
        <input
          type="checkbox"
          id="chat-reasoning-toggle"
          <%= activeChat.reasoning_mode && activeChat.reasoning_mode !== 'off' ? 'checked' : '' %>
        />
        <span>Reasoning</span>
      </label>

      <span
        class="cost-chip chip chip--accent"
        id="cost-chip"
        title="Total OpenClaw spend today (refreshes every 30s)"
        hidden
      ></span>

      <% if (activeChat.project_id) { %>
        <form
          method="post"
          action="/chats/<%= activeChat.id %>/shares"
          class="share-form"
          title="When on, after each assistant reply you get suggested facts to add to the project (you confirm each)."
        >
          <label class="share-toggle">
            <input
              type="checkbox"
              name="shares"
              value="1"
              <%= activeChat.shares_to_project ? 'checked' : '' %>
              onchange="this.form.submit()"
            />
            <span>Suggest facts for project</span>
          </label>
        </form>
      <% } %>

      <button
        type="button"
        class="stop-btn btn btn--danger btn--sm"
        id="stop-btn"
        aria-label="Stop generation"
        title="Stop this turn"
        <%= isWorking ? '' : 'hidden' %>
      >■ Stop</button>

      <form method="post" action="/chats/<%= activeChat.id %>/delete" class="delete-form">
        <button type="submit" onclick="return confirm('Delete this chat?')" aria-label="Delete">
          ×
        </button>
      </form>
    </header>

    <section
      class="messages"
      id="messages"
      data-chat-id="<%= activeChat.id %>"
      data-defer-paint="1"
    >
      <div class="messages-thread">
        <% if (chatMessages.length === 0) { %>
          <p class="muted empty-state">No messages yet. Say something.</p>
        <% } else { %>
          <% chatMessages.forEach(function (m) { %>
            <div class="msg <%= m.role %>" data-msg-id="<%= m.id %>">
              <div class="role"><%= m.role %></div>
              <div class="msg-body"><%= m.content %></div>
            </div>
          <% }); %>
        <% } %>
        <% if (isWorking) { %>
          <%
            // Activity persists across page reloads — server side state. The
            // client's WS connection picks up live events after subscribing.
            const _act = currentActivity || { kind: 'thinking', label: 'Thinking…' };
            const _waitingClass = _act.kind === 'tool' || _act.kind === 'lifecycle'
              ? 'stream-tool'
              : (_act.kind === 'generating' ? 'stream-generating' : 'stream-waiting');
            const _detail = _act.kind === 'tool' && _act.detail && _act.detail !== _act.label
              ? _act.detail
              : '';
          %>
          <div class="msg assistant streaming <%= _waitingClass %>" id="reload-placeholder">
            <div class="role">assistant</div>
            <div
              class="stream-status<%= _detail ? ' has-detail' : '' %>"
              <% if (_detail) { %>
                data-detail="<%= _detail %>"
                data-label="<%= _act.label %>"
                title="<%= _detail %>"
              <% } %>
            ><%= _act.label %></div>
            <div class="msg-body stream-body"></div>
          </div>
        <% } %>
      </div>
    </section>

    <section class="queue" id="queue" aria-live="polite"></section>

    <%- include('partials/composer') %>

    <script src="/js/vendor/marked.min.js"></script>
    <script src="/js/vendor/highlight.min.js"></script>
    <script src="/js/iclaw.js"></script>
  </main>
</div>

<%- include('partials/foot') %>
