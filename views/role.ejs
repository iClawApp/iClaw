<%- include('partials/head', { title: role.name + ' — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main role-page" data-role-id="<%= role.id %>">
    <div class="role-inner">
      <% if (typeof agentsError !== 'undefined' && agentsError) { %>
      <%- include('partials/gatewayError', { agentsError, gatewayUp, openclawBaseUrl }) %>
      <% } %>

      <header class="role-head">
        <%- include('partials/mobile-nav-toggle') %>
        <a class="role-back" href="/roles" aria-label="All roles">← Roles</a>
        <div class="role-hero">
          <span class="role-hero-icon" aria-hidden="true"><%= role.icon %></span>
          <div class="role-hero-text">
            <h1 class="role-hero-name"><%= role.name %></h1>
            <p class="role-hero-tagline"><%= role.tagline %></p>
          </div>
        </div>
      </header>

      <!-- Connect the role's tools (one-tap, one token, verified server-side). -->
      <% role.tools.forEach(function (t) {
        const _label = t.id.charAt(0).toUpperCase() + t.id.slice(1);
        const _scopeText = t.scope === 'read_write' ? 'read + write' : 'read-only';
      %>
        <div class="role-tool" data-tool="<%= t.id %>" data-scope="<%= t.scope %>" data-label="<%= t.connectLabel %>">
          <div class="role-connect<%= t.connected ? ' role-connect--on' : '' %>" data-role="bar">
            <% if (t.connected) { %>
              <span class="role-connect-dot" aria-hidden="true"></span>
              <span class="role-connect-label"><%= _label %> connected<% if (t.connectedWorkspace) { %> · <span class="role-connect-ws"><%= t.connectedWorkspace %></span><% } %></span>
              <button type="button" class="role-connect-manage" data-action="disconnect">Disconnect</button>
            <% } else { %>
              <span class="role-connect-need">This role works in your <strong><%= _label %></strong> (<%= _scopeText %>).</span>
              <button type="button" class="role-connect-btn" data-action="connect"><%= t.connectLabel %></button>
            <% } %>
          </div>

          <% if (t.connect === 'token') { %>
          <form class="role-connect-panel" data-role="panel" hidden>
            <p class="role-connect-howto">
              <% if (t.id === 'notion') { %>
                Open <a href="https://www.notion.so/my-integrations" target="_blank" rel="noopener noreferrer">notion.so/my-integrations</a>,
                create an internal integration, copy its <strong>Internal Integration Secret</strong>, then share your target
                page with it (the page’s ••• menu → <em>Connections</em>).
              <% } else { %>
                Paste your <%= t.id %> access token.
              <% } %>
            </p>
            <div class="role-connect-row">
              <input
                type="password"
                class="role-connect-input"
                data-role="token"
                placeholder="<%= t.id === 'notion' ? 'ntn_… or secret_…' : 'access token' %>"
                autocomplete="off"
                spellcheck="false"
              />
              <button type="submit" class="role-connect-btn" data-role="save">Save</button>
              <button type="button" class="role-connect-cancel" data-action="cancel">Cancel</button>
            </div>
            <p class="role-connect-msg" data-role="msg" hidden></p>
          </form>
          <% } %>
        </div>
      <% }); %>

      <!-- Per-role memory — teach it once; it uses this on every run (role ≠ GPT). -->
      <details class="role-memory"<% if (role.memory) { %> data-set="1"<% } %>>
        <summary class="role-memory-summary">
          <span class="role-memory-icon" aria-hidden="true">🧠</span>
          <span class="role-memory-label"><%= role.memory ? 'Remembers your brand & context' : 'Teach it your brand & context' %></span>
          <span class="role-memory-edit">Edit</span>
        </summary>
        <form class="role-memory-form" id="role-memory-form">
          <p class="role-memory-help muted">Tell it once who you are — brand, audience, voice, anything it should assume. It uses this on every run instead of asking again.</p>
          <textarea
            id="role-memory-input"
            class="role-memory-input"
            rows="3"
            placeholder="e.g. B2B SaaS for ops teams. Voice: direct, concrete, no hype. Audience: heads of operations at 50–200-person companies."
          ><%= role.memory %></textarea>
          <div class="role-memory-actions">
            <button type="submit" class="role-memory-save">Save</button>
            <span class="role-memory-msg muted" data-role="mem-msg" hidden></span>
          </div>
        </form>
      </details>

      <!-- Delegation examples — the cure for the blank screen. -->
      <section class="role-examples" aria-label="Things this role can do">
        <p class="role-examples-lead muted">Hand it something:</p>
        <div class="role-examples-grid">
          <% role.delegationExamples.forEach(function (ex) { %>
            <button type="button" class="role-example" data-fill="<%= ex.replace(/\"/g, '&quot;') %>">
              <%= ex %>
            </button>
          <% }); %>
        </div>
      </section>

      <!-- Task input — give it one line. -->
      <form class="role-run" id="role-run-form">
        <textarea
          id="role-task-input"
          class="role-task-input"
          rows="2"
          placeholder="…or describe the task in one line"
          autocomplete="off"
        ></textarea>
        <button type="submit" class="role-run-btn">Run</button>
      </form>

      <!-- Deliverable / review surface (filled once a run completes). -->
      <section class="role-result" id="role-result" hidden aria-live="polite"></section>

      <footer class="role-foot muted">
        It brings a <strong><%= role.deliverable.type.replace(/_/g, ' ') %></strong> for you to review.
        Nothing is published, sent, or deleted outside the box without your tap.
        “Delete” tears the box down — your work stays in the tool.
      </footer>
    </div>
  </main>
</div>

<script>
  (function () {
    // 1) Delegation example → fill the task input (and focus it).
    var input = document.getElementById('role-task-input');
    document.querySelectorAll('.role-example').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!input) return;
        input.value = btn.getAttribute('data-fill') || btn.textContent.trim();
        input.focus();
        input.setSelectionRange(input.value.length, input.value.length);
      });
    });

    // 2) Tool connect / disconnect — one paste, verified server-side, bar
    //    re-renders in place (no reload). Connection is shared across roles.
    function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }
    function esc(s) {
      return String(s).replace(/[&<>"]/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
      });
    }
    function showMsg(el, text, isErr) {
      if (!el) return;
      el.textContent = text;
      el.hidden = false;
      el.classList.toggle('role-connect-msg--err', !!isErr);
    }
    function renderConnected(bar, toolId, workspace) {
      bar.classList.add('role-connect--on');
      bar.innerHTML =
        '<span class="role-connect-dot" aria-hidden="true"></span>' +
        '<span class="role-connect-label">' + esc(cap(toolId)) + ' connected' +
        (workspace ? ' · <span class="role-connect-ws">' + esc(workspace) + '</span>' : '') +
        '</span>' +
        '<button type="button" class="role-connect-manage" data-action="disconnect">Disconnect</button>';
    }
    function renderDisconnected(bar, toolId, scope, label) {
      bar.classList.remove('role-connect--on');
      var scopeText = scope === 'read_write' ? 'read + write' : 'read-only';
      bar.innerHTML =
        '<span class="role-connect-need">This role works in your <strong>' + esc(cap(toolId)) +
        '</strong> (' + scopeText + ').</span>' +
        '<button type="button" class="role-connect-btn" data-action="connect">' + esc(label) + '</button>';
    }

    document.querySelectorAll('.role-tool').forEach(function (tool) {
      var toolId = tool.getAttribute('data-tool');
      var scope = tool.getAttribute('data-scope') || 'read';
      var label = tool.getAttribute('data-label') || ('Connect ' + cap(toolId));
      var bar = tool.querySelector('[data-role="bar"]');
      var panel = tool.querySelector('[data-role="panel"]');

      function setPanel(open) {
        if (!panel) return;
        panel.hidden = !open;
        var msg = panel.querySelector('[data-role="msg"]');
        if (msg) { msg.hidden = true; msg.textContent = ''; }
        if (open) {
          var inp = panel.querySelector('[data-role="token"]');
          if (inp) { inp.value = ''; setTimeout(function () { inp.focus(); }, 0); }
        }
      }

      // Delegated clicks (bar re-renders, so listen on the stable wrapper).
      tool.addEventListener('click', function (e) {
        var hit = e.target.closest('[data-action]');
        if (!hit || !tool.contains(hit)) return;
        var action = hit.getAttribute('data-action');
        if (action === 'connect') setPanel(true);
        else if (action === 'cancel') setPanel(false);
        else if (action === 'disconnect') {
          fetch('/roles/tools/' + encodeURIComponent(toolId) + '/disconnect', { method: 'POST' })
            .then(function (r) { return r.json(); })
            .then(function () { renderDisconnected(bar, toolId, scope, label); })
            .catch(function () {});
        }
      });

      if (panel) {
        panel.addEventListener('submit', function (e) {
          e.preventDefault();
          var inp = panel.querySelector('[data-role="token"]');
          var msg = panel.querySelector('[data-role="msg"]');
          var save = panel.querySelector('[data-role="save"]');
          var token = ((inp && inp.value) || '').trim();
          if (!token) { showMsg(msg, 'Paste your token first.', true); return; }
          if (save) { save.disabled = true; save.textContent = 'Connecting…'; }
          fetch('/roles/tools/' + encodeURIComponent(toolId) + '/connect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: token }),
          })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
            .then(function (res) {
              if (!res.ok || !res.j || !res.j.ok) {
                showMsg(msg, (res.j && res.j.error) || 'Could not connect.', true);
                return;
              }
              setPanel(false);
              renderConnected(bar, toolId, res.j.workspaceName);
            })
            .catch(function () { showMsg(msg, 'Network error. Try again.', true); })
            .finally(function () { if (save) { save.disabled = false; save.textContent = 'Save'; } });
        });
      }
    });

    // 3) Run the role — start a session, stream progress, surface the deliverable.
    var roleEl = document.querySelector('.role-page');
    var roleId = roleEl ? roleEl.getAttribute('data-role-id') : null;
    var runForm = document.getElementById('role-run-form');
    var resultEl = document.getElementById('role-result');
    var currentRun = null; // { runId, es }

    function activityLabel(name) {
      switch (name) {
        case 'notion_search': return 'Looking for your Notion page…';
        case 'notion_create_database': return 'Building the database…';
        case 'notion_add_row': return 'Filling in rows…';
        case 'web_search':
        case 'web_fetch': return 'Researching…';
        default: return 'Working…';
      }
    }
    function setResult(html) { if (resultEl) { resultEl.innerHTML = html; resultEl.hidden = false; } }
    function statusHtml(label, cancelText) {
      return '<div class="role-run-status"><span class="role-run-spinner" aria-hidden="true"></span>' +
        '<span class="role-run-activity">' + esc(label) + '</span></div>' +
        '<button type="button" class="role-run-cancel" data-run-cancel>' + esc(cancelText) + '</button>';
    }

    function startRun(task) {
      if (!roleId || !task) return;
      setResult('<div class="role-run-status"><span class="role-run-spinner" aria-hidden="true"></span><span class="role-run-activity">Starting…</span></div>');
      var btn = runForm ? runForm.querySelector('.role-run-btn') : null;
      if (btn) btn.disabled = true;
      fetch('/roles/' + encodeURIComponent(roleId) + '/run', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ task: task }),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.j || !res.j.ok) {
            setResult('<p class="role-result-err">' + esc((res.j && res.j.error) || 'Could not start.') + '</p>');
            return;
          }
          streamRun(res.j.runId);
        })
        .catch(function () { setResult('<p class="role-result-err">Network error. Try again.</p>'); })
        .finally(function () { if (btn) btn.disabled = false; });
    }

    function textToHtml(s) {
      var capped = s.length > 1200 ? s.slice(0, 1200) + '…' : s;
      return esc(capped).replace(/\n/g, '<br>');
    }

    function streamRun(runId) {
      currentRun = { runId: runId, es: null };
      var finalText = '';
      setResult(statusHtml('Thinking…', 'Stop & delete'));
      var es = new EventSource('/roles/' + encodeURIComponent(roleId) + '/run/' + encodeURIComponent(runId) + '/events');
      currentRun.es = es;
      es.onmessage = function (e) {
        var ev; try { ev = JSON.parse(e.data); } catch (_) { return; }
        if (ev.type === 'text') { finalText += (ev.content || ''); }
        else if (ev.type === 'tool_start') setResult(statusHtml(activityLabel(ev.name), 'Stop & delete'));
        else if (ev.type === 'error') { es.close(); setResult('<p class="role-result-err">' + esc(ev.message || 'Something went wrong.') + '</p>'); }
        else if (ev.type === 'done') { es.close(); finishRun(runId, finalText.trim()); }
      };
    }

    function finishRun(runId, finalText) {
      fetch('/roles/' + encodeURIComponent(roleId) + '/run/' + encodeURIComponent(runId) + '/result')
        .then(function (r) { return r.json(); })
        .then(function (j) {
          var d = j && j.deliverable;
          if (d && d.url) {
            setResult(
              '<div class="role-deliverable">' +
                '<p class="role-deliverable-title">✓ ' + esc(d.title || 'Your deliverable') +
                  ' — ' + (d.rows || 0) + ' row' + ((d.rows === 1) ? '' : 's') + '</p>' +
                (finalText ? '<p class="role-deliverable-summary">' + textToHtml(finalText) + '</p>' : '') +
                '<div class="role-deliverable-actions">' +
                  '<a class="role-deliverable-link" href="' + esc(d.url) + '" target="_blank" rel="noopener noreferrer">Open in Notion →</a>' +
                  '<button type="button" class="role-run-cancel" data-run-cancel>Delete (fire the worker)</button>' +
                '</div>' +
                '<p class="role-deliverable-note muted">Your work stays in Notion — Delete just tears down the worker.</p>' +
              '</div>'
            );
          } else {
            // No database built (e.g. no page shared yet) — show what the worker
            // said so the user knows the next step, not a bare "Done."
            setResult(
              '<div class="role-run-message">' +
                (finalText ? '<p class="role-run-message-text">' + textToHtml(finalText) + '</p>'
                           : '<p class="role-run-message-text">Done — but nothing was created. Make sure you’ve shared a Notion page with the integration, then try again.</p>') +
                '<button type="button" class="role-run-cancel" data-run-cancel>Delete</button>' +
              '</div>'
            );
          }
        })
        .catch(function () { setResult('<p class="role-result-done">Done.</p>'); });
    }

    function deleteRun() {
      if (!currentRun) { if (resultEl) resultEl.hidden = true; return; }
      var runId = currentRun.runId;
      if (currentRun.es) { try { currentRun.es.close(); } catch (_) {} }
      fetch('/roles/' + encodeURIComponent(roleId) + '/run/' + encodeURIComponent(runId), { method: 'DELETE' }).catch(function () {});
      currentRun = null;
      setResult('<p class="role-result-done muted">Fired. Your work stays in the tool.</p>');
    }

    if (runForm) {
      runForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var task = ((input && input.value) || '').trim();
        if (!task) { if (input) input.focus(); return; }
        startRun(task);
      });
    }
    if (resultEl) {
      resultEl.addEventListener('click', function (e) {
        if (e.target.closest('[data-run-cancel]')) deleteRun();
      });
    }

    // 4) Per-role memory — teach it once, it remembers across runs.
    var memForm = document.getElementById('role-memory-form');
    if (memForm && roleId) {
      memForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var inp = document.getElementById('role-memory-input');
        var msg = memForm.querySelector('[data-role="mem-msg"]');
        var note = ((inp && inp.value) || '').trim();
        fetch('/roles/' + encodeURIComponent(roleId) + '/memory', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ note: note }),
        })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (msg) { msg.textContent = j.saved ? 'Saved — it’ll remember.' : 'Cleared.'; msg.hidden = false; }
            var label = document.querySelector('.role-memory-label');
            if (label) label.textContent = j.saved ? 'Remembers your brand & context' : 'Teach it your brand & context';
          })
          .catch(function () { if (msg) { msg.textContent = 'Could not save — try again.'; msg.hidden = false; } });
      });
    }
  })();
</script>

<%- include('partials/foot') %>
