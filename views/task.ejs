<%
  const statusLabels = {
    inbox: 'Draft',
    ready: 'Ready to run',
    running: 'Running',
    needs_human: 'Your turn',
    needs_review: 'Review result',
    done: 'Done',
    failed: 'Failed',
  };
  const statusLabel = statusLabels[task.status] || task.status;
  const nextByStatus = {
    inbox: {
      title: 'Step 1: approve the plan',
      body: 'Run agent unlocks only after approval. Review the steps below, then tap Approve & run — or Approve plan if you want to run later.',
    },
    ready: {
      title: 'Run the agent',
      body: 'The plan is approved. The agent works in the background; your chat only gets short status notes.',
    },
    running: {
      title: 'Agent is working',
      body: 'Watch Agent output below. You can leave this page — the source chat stays quiet.',
    },
    needs_human: {
      title: 'Your input needed',
      body: 'The agent paused this task. Answer the request below, then tap Continue.',
    },
    needs_review: {
      title: 'Check the result',
      body: 'Review the output, then mark Done or Failed.',
    },
    done: {
      title: 'All done',
      body: 'This task is complete.',
    },
    failed: {
      title: 'Task failed',
      body: 'You can mark Done to close it, or leave it as Failed.',
    },
  };
  const next = nextByStatus[task.status] || nextByStatus.inbox;
  const actorLabels = { agent: 'Agent', human: 'You' };
  const stepStatusLabels = {
    todo: '',
    running: 'In progress',
    needs_human: 'Your turn',
    done: 'Done',
    failed: 'Failed',
  };
  const canRun = task.status === 'ready';
  const showApprove = task.status === 'inbox';
%>
<%- include('partials/head', { title: task.title + ' — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main task-page" data-task-id="<%= task.id %>">
    <div class="task-shell task-shell--wide">
      <a href="<%= task.project_id ? '/projects/' + task.project_id : '/tasks' %>" class="task-back">
        <span class="task-back-chevron" aria-hidden="true">‹</span> Tasks
      </a>

      <header class="task-large-header">
        <h1 class="task-large-title"><%= task.title %></h1>
      </header>

      <div class="task-next-card task-next-card--<%= task.status %>">
        <% if (showApprove || canRun) { %>
          <ol class="task-flow-steps" aria-label="Task progress">
            <li class="task-flow-step<%= showApprove ? ' is-current' : ' is-done' %>">
              <span class="task-flow-step-num">1</span> Approve plan
            </li>
            <li class="task-flow-step<%= canRun ? ' is-current' : '' %><%= task.status === 'running' || task.status === 'needs_human' || task.status === 'needs_review' || task.status === 'done' || task.status === 'failed' ? ' is-done' : '' %>">
              <span class="task-flow-step-num">2</span> Run agent
            </li>
          </ol>
        <% } %>
        <span class="task-pill task-pill--<%= task.status %>"><%= statusLabel %></span>
        <h2 class="task-next-title"><%= next.title %></h2>
        <p class="task-next-body"><%= next.body %></p>
        <p class="task-goal-label">Goal</p>
        <div class="task-goal-text task-md msg-body" id="task-goal-text"><%= task.goal %></div>
        <% if (task.current_step_title && task.status === 'running') { %>
          <p class="task-plan-step-now">Plan step: <%= task.current_step_title %></p>
        <% } %>
      </div>

      <% if (showApprove || canRun) { %>
        <ul class="task-inset-list task-inset-list--actions task-inset-list--primary">
          <% if (showApprove) { %>
            <li><button type="button" class="task-row-btn task-row-btn--primary" id="task-approve-and-run">Approve &amp; run</button></li>
            <li><button type="button" class="task-row-btn" id="task-approve-plan">Approve plan only</button></li>
          <% } %>
          <% if (canRun) { %>
            <li><button type="button" class="task-row-btn task-row-btn--primary" id="task-run-btn">Run agent</button></li>
          <% } %>
        </ul>
      <% } else if (task.status !== 'needs_human') { %>
        <ul class="task-inset-list task-inset-list--actions task-inset-list--primary">
          <li class="task-inset-empty task-inset-empty--inline">Use the actions below when you are ready.</li>
        </ul>
      <% } %>

      <% if (task.status === 'needs_human') {
        const askPreamble = humanAsk && humanAsk.preamble ? humanAsk.preamble : '';
        const askQuestion = humanAsk && humanAsk.question
          ? humanAsk.question
          : (task.result_summary || '');
      %>
        <section class="task-group task-human-card" id="task-human-block">
          <h2 class="task-section-title">Response needed</h2>
          <p class="task-human-lead">
            The agent stopped and is waiting for you. Read the request, write your answer, then tap
            <strong>Continue</strong>.
          </p>
          <% if (task.current_step_title) { %>
            <p class="task-human-plan-step">
              <span class="task-human-plan-step-label">Plan step</span>
              <%= task.current_step_title %>
            </p>
          <% } %>
          <% if (askPreamble || askQuestion) { %>
            <div class="task-human-ask">
              <h3 class="task-human-ask-heading">Agent request</h3>
              <% if (askPreamble) { %>
                <p class="task-human-ask-label">Context</p>
                <div class="task-human-ask-copy task-md msg-body"><%= askPreamble %></div>
              <% } %>
              <% if (askQuestion) { %>
                <% if (askPreamble) { %>
                  <p class="task-human-ask-label">What we need from you</p>
                <% } %>
                <div class="task-human-ask-copy task-md msg-body"><%= askQuestion %></div>
              <% } %>
            </div>
          <% } %>
          <div class="task-human-compose">
            <label class="task-human-compose-label" for="task-human-input">Your answer</label>
            <div class="task-human-field">
              <textarea
                id="task-human-input"
                class="task-human-input iclaw-thin-scroll"
                rows="1"
                placeholder="Write your reply to the agent…"
              ></textarea>
            </div>
          </div>
          <ul class="task-inset-list task-inset-list--actions task-human-actions">
            <li>
              <button type="button" class="task-row-btn task-row-btn--primary" id="task-resume-btn">Continue</button>
            </li>
          </ul>
        </section>
      <% } %>

      <section class="task-group">
        <h2 class="task-section-title">Plan</h2>
        <p class="task-section-footnote">What happens, step by step</p>
        <ul class="task-inset-list" id="task-steps-list">
          <% if (task.steps.length === 0) { %>
            <li class="task-inset-empty">No steps — tap Add step below.</li>
          <% } %>
          <% task.steps.forEach(function (s) { %>
            <li class="task-step-row" data-step-id="<%= s.id %>">
              <span class="task-step-badge task-step-badge--<%= s.actor %>" aria-hidden="true"><%= s.actor === 'human' ? '👤' : '✦' %></span>
              <div class="task-step-main">
                <span class="task-step-actor-label"><%= actorLabels[s.actor] || s.actor %></span>
                <textarea class="task-step-input" rows="1" data-actor="<%= s.actor %>" aria-label="Step"><%= s.title %></textarea>
              </div>
              <% const stepStatus = stepStatusLabels[s.status] || ''; %>
              <% if (stepStatus) { %>
                <span class="task-step-state task-step-state--<%= s.status %>"><%= stepStatus %></span>
              <% } %>
            </li>
          <% }); %>
        </ul>
        <button type="button" class="task-row-action" id="task-add-step">Add step</button>
      </section>

      <section class="task-group">
        <h2 class="task-section-title">Finish</h2>
        <p class="task-section-footnote">Close the task early if you no longer need the agent</p>
        <ul class="task-inset-list task-inset-list--actions">
          <li><button type="button" class="task-row-btn" id="task-done-btn">Mark as done</button></li>
          <li><button type="button" class="task-row-btn task-row-btn--destructive" id="task-fail-btn">Mark as failed</button></li>
        </ul>
      </section>

      <section class="task-group task-group--log">
        <h2 class="task-section-title">Agent output</h2>
        <p class="task-section-footnote">Execution log — not saved to the chat</p>
        <div class="task-log" id="task-execution-log">
          <% if (executionLog.length === 0) { %>
            <p class="task-log-empty">Empty until you run the agent.</p>
          <% } %>
          <% executionLog.forEach(function (m) { %>
            <article class="task-log-entry task-log-entry--<%= m.role %>">
              <header class="task-log-entry-head"><%= m.role === 'assistant' ? 'Agent' : m.role %></header>
              <div class="task-log-entry-body task-md msg-body"><%= m.content.slice(0, 8000) %></div>
            </article>
          <% }); %>
        </div>
        <% if (task.execution_chat_id) { %>
          <a href="/chats/<%= task.execution_chat_id %>" class="task-lede-link task-log-link">Open technical thread</a>
        <% } %>
      </section>

      <details class="task-disclosure">
        <summary>
          <span class="task-disclosure-title">Frozen context</span>
          <span class="task-disclosure-sub">Source chat and snapshot from when this task was created</span>
        </summary>
        <div class="task-disclosure-body">
          <p class="task-disclosure-lede-title">Not the same as chat</p>
          <p class="task-disclosure-lede">
            A <strong>task</strong> freezes your chat context, runs the agent on a plan, and keeps a
            separate log here. Your message thread does not fill with tool output.
          </p>
          <% if (sourceChat) { %>
            <p class="task-disclosure-source">
              <a href="/chats/<%= sourceChat.id %>" class="task-lede-link">Source chat: <%= sourceChat.title %></a>
            </p>
          <% } %>
          <% if (snapshotPreview) { %>
            <p class="task-disclosure-meta">
              <%= snapshotPreview.messageCount %> messages · <%= snapshotPreview.projectFactsCount %> project facts
            </p>
            <% if (snapshotPreview.secretRefs.length) { %>
              <p class="task-disclosure-meta">
                Secrets (refs only): <%= snapshotPreview.secretRefs.map(function (r) { return r.label; }).join(', ') %>
              </p>
            <% } %>
          <% } %>
        </div>
      </details>
    </div>
  </main>
</div>

<script>
  window.__ICLAW_TASK__ = <%- JSON.stringify({ id: task.id, status: task.status, executionChatId: task.execution_chat_id }) %>;
</script>
<script src="/js/vendor/marked.min.js"></script>
<script src="/js/vendor/highlight.min.js"></script>
<script src="/js/iclaw.js"></script>

<%- include('partials/foot') %>
