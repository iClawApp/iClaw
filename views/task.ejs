<%
  const statusLabels = {
    planning: 'Preparing',
    ready: 'Ready',
    running: 'Running',
    needs_human: 'Your turn',
    needs_clarification: 'Clarification',
    needs_review: 'Review result',
    done: 'Done',
    failed: 'Failed',
  };
  const statusLabel = statusLabels[task.status] || task.status;
  const nextByStatus = {
    planning: {
      title: 'Preparing task',
      body: 'OpenClaw is building the plan from your goal and chat context. This usually takes a minute.',
    },
    ready: {
      title: 'Ready to run',
      body: 'Review the plan, then Run agent. Plan changes save automatically.',
    },
    running: {
      title: 'Agent is working',
      body: 'Watch Agent output below. You can leave this page — the source chat stays quiet.',
    },
    needs_human: {
      title: 'Your input needed',
      body: 'The agent paused this task. Answer the request below, then tap Continue.',
    },
    needs_clarification: {
      title: 'Quick clarification',
      body: 'The agent asked a one-off question. Your answer is not saved in the task context — only used to continue the current step.',
    },
    needs_review: {
      title: 'Check the result',
      body: 'Review the output below, then mark the task done or failed.',
    },
    done: {
      title: 'All done',
      body: 'This task is complete.',
    },
    failed: {
      title: 'Task failed',
      body: 'You can mark Done to close it, or leave it as Failed.',
    },
  };
  const next = nextByStatus[task.status] || nextByStatus.ready;
  const actorLabels = { agent: 'Agent', human: 'You' };
  const stepStatusLabels = {
    todo: '',
    running: 'In progress',
    needs_human: 'Your turn',
    done: 'Done',
    failed: 'Failed',
  };
  const isPlanning = task.status === 'planning';
  const canRun = task.status === 'ready';
  const showAgentOutput = task.status !== 'ready' && task.status !== 'planning';
  const planEditorEnabled = !isPlanning;
  const isNeedsHuman = task.status === 'needs_human';
  const isNeedsClarification = task.status === 'needs_clarification';
  const showHumanInputBlock = isNeedsHuman || isNeedsClarification;
  const isNeedsReview = task.status === 'needs_review';
  const isFailed = task.status === 'failed';
  const showCompleteActions = isNeedsReview || isFailed;
  const waitingPlanStep = isNeedsHuman
    ? task.steps.find(function (s) { return s.status === 'needs_human'; })
    : null;
  const runningStepTitle =
    task.status === 'running' || isNeedsClarification
      ? (task.steps.find(function (s) { return s.status === 'running'; }) || {}).title
      : '';
  const taskSyncFingerprint = [
    task.status,
    task.current_step_title || '',
    task.steps.map(function (s) {
      return s.id + ':' + s.status + ':' + (s.result_summary || '');
    }).join(','),
  ].join('|');
%>
<%- include('partials/head', { title: task.title + ' — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main task-page" data-task-id="<%= task.id %>">
    <div class="task-shell">
      <a href="/tasks" class="task-back">
        <span class="task-back-chevron" aria-hidden="true">‹</span> Tasks
      </a>

      <header class="task-large-header">
        <div class="task-large-header-row">
          <form class="task-large-title-form" id="task-rename-form" onsubmit="return false">
            <input
              type="text"
              id="task-title-input"
              class="task-large-title"
              value="<%= task.title %>"
              aria-label="Task title"
              maxlength="200"
              autocomplete="off"
            />
          </form>
          <div class="task-large-header-actions">
            <button type="button" class="task-ask-open-btn" id="task-ask-open-btn">
              <span class="task-ask-open-btn__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M8 1.25a5.75 5.75 0 0 0-5.75 5.75c0 3.17 2.58 5.75 5.75 5.75.78 0 1.52-.16 2.19-.44l2.35 1.17a.75.75 0 0 0 1.08-.68l-.28-2.47A5.73 5.73 0 0 0 13.75 7 5.75 5.75 0 0 0 8 1.25Z"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span class="task-ask-open-btn__label">Ask</span>
            </button>
            <span class="task-pill task-pill--<%= task.status %>"><%= statusLabel %></span>
          </div>
        </div>
      </header>

      <% if (!showHumanInputBlock) { %>
        <p class="task-hint task-hint--below-title"><%= next.body %></p>
        <% if (task.current_step_title && task.status === 'running') { %>
          <p class="task-hint task-hint--sub"><%= task.current_step_title %></p>
        <% } %>
      <% } %>

      <details class="task-disclosure task-disclosure--plan<%= isPlanning ? ' task-disclosure--planning' : '' %>"<%= showHumanInputBlock || isPlanning ? '' : ' open' %>>
        <summary>
          <span class="task-disclosure-title">Plan</span>
          <span class="task-disclosure-sub" id="task-steps-count"><%= task.steps.length %> steps</span>
        </summary>
        <div class="task-disclosure-body task-disclosure-body--flush">
        <ul class="task-inset-list task-steps-list<%= planEditorEnabled ? '' : ' task-steps-list--readonly' %>" id="task-steps-list"<%= planEditorEnabled ? '' : ' data-plan-readonly="1"' %>>
          <% if (task.steps.length === 0) { %>
            <li class="task-step-insert task-step-insert--empty">
              <button type="button" class="task-step-insert-btn" title="Add step" aria-label="Add step">+</button>
            </li>
          <% } else {
            const firstStepLocked = task.steps[0] && (task.steps[0].status === 'done' || task.steps[0].status === 'failed');
          %>
            <li class="task-step-insert task-step-insert--leading<%= firstStepLocked ? ' task-step-insert--hidden' : '' %>">
              <button type="button" class="task-step-insert-btn" title="Add step before first" aria-label="Add step before first">+</button>
            </li>
          <% } %>
          <% task.steps.forEach(function (s) {
            const stepLocked = s.status === 'done' || s.status === 'failed';
            const stepStatus = stepStatusLabels[s.status] || '';
            const outputLabel = s.actor === 'human' ? 'Your answer' : 'Agent output';
          %>
            <li
              class="task-step-row<%= stepLocked ? ' task-step-row--locked' : '' %>"
              data-step-id="<%= s.id %>"
              data-step-status="<%= s.status %>"
              data-step-locked="<%= stepLocked ? '1' : '0' %>"
            >
              <% if (stepLocked) { %>
                <div class="task-step-aside">
                  <div
                    class="task-step-actor-static task-step-actor-static--<%= s.actor %>"
                    aria-label="<%= actorLabels[s.actor] || s.actor %>"
                  >
                    <span class="task-step-badge task-step-badge--<%= s.actor %>" aria-hidden="true"><%= s.actor === 'human' ? '👤' : '✦' %></span>
                    <span class="task-step-actor-label"><%= actorLabels[s.actor] || s.actor %></span>
                  </div>
                  <% if (stepStatus) { %>
                    <span class="task-step-state task-step-state--<%= s.status %>"><%= stepStatus %></span>
                  <% } %>
                </div>
                <div class="task-step-locked-shell">
                  <div class="task-step-head-main">
                    <div class="task-step-title-readonly"><%= s.title %></div>
                    <% if (s.result_summary) { %>
                      <p class="task-step-summary"><%= s.result_summary %></p>
                    <% } %>
                  </div>
                  <% if (s.result_body) { %>
                    <details class="task-step-output">
                      <summary><%= outputLabel %></summary>
                      <div class="task-step-output-body task-md msg-body"><%= s.result_body %></div>
                    </details>
                  <% } %>
                </div>
              <% } else { %>
                <div class="task-step-aside">
                  <button
                    type="button"
                    class="task-step-actor-toggle task-step-actor-toggle--<%= s.actor %>"
                    aria-label="<%= (actorLabels[s.actor] || s.actor) %> — switch to <%= s.actor === 'human' ? 'Agent' : 'You' %>"
                  >
                    <span class="task-step-badge task-step-badge--<%= s.actor %>" aria-hidden="true"><%= s.actor === 'human' ? '👤' : '✦' %></span>
                    <span class="task-step-actor-label"><%= actorLabels[s.actor] || s.actor %></span>
                  </button>
                  <% if (stepStatus) { %>
                    <span class="task-step-state task-step-state--<%= s.status %>"><%= stepStatus %></span>
                  <% } %>
                </div>
                <div class="task-step-main">
                  <textarea class="task-step-input" rows="1" data-actor="<%= s.actor %>" aria-label="Step"><%= s.title %></textarea>
                </div>
                <button type="button" class="task-step-delete" title="Remove step" aria-label="Remove step">
                  <svg class="task-step-delete-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6"/><path d="M14 11v6"/>
                  </svg>
                </button>
              <% } %>
            </li>
            <li class="task-step-insert<%= stepLocked ? ' task-step-insert--hidden' : '' %>">
              <button type="button" class="task-step-insert-btn" title="Add step after" aria-label="Add step after">+</button>
            </li>
          <% }); %>
        </ul>
        </div>
      </details>

      <% if (canRun) { %>
        <ul class="task-inset-list task-inset-list--actions task-inset-list--actions-primary task-inset-list--run-row">
          <li class="task-run-row">
            <button type="button" class="task-row-btn task-row-btn--primary" id="task-run-btn">Run agent</button>
            <button type="button" class="task-row-btn task-row-btn--compact task-row-btn--destructive" id="task-delete-btn">Delete task</button>
          </li>
        </ul>
      <% } %>

      <% if (showHumanInputBlock) {
        const askPreamble = humanAsk && humanAsk.preamble ? humanAsk.preamble : '';
        const askQuestion = humanAsk && humanAsk.question
          ? humanAsk.question
          : (task.result_summary || '');
      %>
        <section class="task-human-block<%= isNeedsClarification ? ' task-human-block--clarification' : '' %>" id="task-human-block">
          <% if (isNeedsClarification && runningStepTitle) { %>
            <p class="task-focus-waiting muted">Current step: <%= runningStepTitle %></p>
          <% } %>
          <% if (waitingPlanStep) { %>
            <p class="task-focus-waiting"><%= waitingPlanStep.title %></p>
          <% } %>
          <% if (askQuestion) { %>
            <div class="task-focus-ask task-md msg-body"><%= askQuestion %></div>
          <% } else if (askPreamble) { %>
            <div class="task-focus-ask task-md msg-body"><%= askPreamble %></div>
          <% } %>
          <% if (askPreamble && askQuestion) { %>
            <details class="task-focus-more">
              <summary>More context from the agent</summary>
              <div class="task-focus-more-body task-md msg-body"><%= askPreamble %></div>
            </details>
          <% } %>
          <div class="task-human-field">
            <textarea
              id="task-human-input"
              class="task-human-input iclaw-thin-scroll"
              rows="1"
              placeholder="<%= isNeedsClarification ? 'Short answer…' : 'Your answer…' %>"
              aria-label="<%= isNeedsClarification ? 'Clarification' : 'Your answer' %>"
            ></textarea>
          </div>
          <button type="button" class="task-row-btn task-row-btn--primary task-human-continue" id="task-resume-btn"><%= isNeedsClarification ? 'Send answer' : 'Continue' %></button>
        </section>
      <% } %>

      <% if (showCompleteActions) { %>
        <ul class="task-inset-list task-inset-list--actions task-inset-list--actions-primary task-inset-list--run-row">
          <li class="task-run-row">
            <button type="button" class="task-row-btn task-row-btn--primary" id="task-done-btn">Mark as done</button>
            <% if (isNeedsReview) { %>
              <button type="button" class="task-row-btn task-row-btn--compact task-row-btn--destructive" id="task-fail-btn">Mark as failed</button>
            <% } %>
          </li>
        </ul>
      <% } %>

      <details class="task-disclosure task-disclosure--inline">
        <summary>Goal</summary>
        <div class="task-disclosure-body">
          <div class="task-goal-text task-md msg-body" id="task-goal-text"><%= task.goal %></div>
        </div>
      </details>

      <% if (!showCompleteActions && task.status !== 'done') { %>
      <details class="task-disclosure">
        <summary><span class="task-disclosure-title">Finish</span></summary>
        <div class="task-disclosure-body task-disclosure-body--flush">
        <ul class="task-inset-list task-inset-list--actions">
          <li><button type="button" class="task-row-btn" id="task-done-btn">Mark as done</button></li>
          <li><button type="button" class="task-row-btn task-row-btn--destructive" id="task-fail-btn">Mark as failed</button></li>
        </ul>
        </div>
      </details>
      <% } %>

      <% if (showAgentOutput) { %>
      <details class="task-disclosure">
        <summary>
          <span class="task-disclosure-title">Agent output</span>
          <span class="task-disclosure-sub">Execution log</span>
        </summary>
        <div class="task-disclosure-body task-disclosure-body--flush">
        <div class="task-log" id="task-execution-log">
          <% if (executionLog.length === 0) { %>
            <p class="task-log-empty">No output yet.</p>
          <% } %>
          <% executionLog.forEach(function (m) { %>
            <article class="task-log-entry task-log-entry--<%= m.role %>">
              <header class="task-log-entry-head"><%= m.role === 'assistant' ? 'Agent' : m.role %></header>
              <div class="task-log-entry-body task-md msg-body"><%= m.content.slice(0, 8000) %></div>
            </article>
          <% }); %>
        </div>
        <% if (task.execution_chat_id) { %>
          <a href="/chats/<%= task.execution_chat_id %>" class="task-lede-link task-log-link">Open technical thread</a>
        <% } %>
        </div>
      </details>
      <% } %>

      <details class="task-disclosure">
        <summary>
          <span class="task-disclosure-title">Frozen context</span>
          <span class="task-disclosure-sub">Source chat and snapshot from when this task was created</span>
        </summary>
        <div class="task-disclosure-body">
          <p class="task-disclosure-lede">
            Frozen snapshot from when this task was created — not the live chat thread.
          </p>
          <% if (sourceChat) { %>
            <p class="task-disclosure-source">
              <a href="/chats/<%= sourceChat.id %>" class="task-lede-link">Source chat: <%= sourceChat.title %></a>
            </p>
          <% } %>
          <% if (snapshotPreview) { %>
            <p class="task-disclosure-meta">
              <%= snapshotPreview.messageCount %> messages · <%= snapshotPreview.projectFactsCount %> project facts
            </p>
            <% if (snapshotPreview.secretRefs.length) { %>
              <p class="task-disclosure-meta">
                Secrets (refs only): <%= snapshotPreview.secretRefs.map(function (r) { return r.label; }).join(', ') %>
              </p>
            <% } %>
          <% } %>
        </div>
      </details>
    </div>
  </main>
</div>

<div class="task-ask-modal" id="task-ask-modal" hidden>
  <div class="task-ask-modal__backdrop" id="task-ask-modal-backdrop"></div>
  <div
    class="task-ask-modal__shell"
    id="task-ask-modal-shell"
    role="dialog"
    aria-modal="true"
    aria-labelledby="task-ask-modal-title"
  >
    <header class="chat-header task-ask-modal__header">
      <div class="task-ask-modal__header-main">
        <h1 id="task-ask-modal-title">Ask</h1>
        <p class="task-ask-modal__hint muted">Свіжий знімок чату й фактів. Діалог не змінює план і статус задачі.</p>
      </div>
    </header>
    <section class="messages iclaw-thin-scroll" id="task-ask-messages" aria-live="polite">
      <div class="messages-thread" id="task-ask-thread"></div>
    </section>
    <form class="composer" id="task-ask-composer" onsubmit="return false">
      <div class="composer-field">
        <div class="composer-input-stack">
          <textarea
            id="task-ask-input"
            rows="1"
            placeholder="Message…"
            aria-label="Message"
          ></textarea>
        </div>
        <button type="button" class="composer-send" id="task-ask-send-btn" aria-label="Send">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
        </button>
      </div>
    </form>
  </div>
  <div class="task-ask-close-confirm" id="task-ask-close-confirm" hidden>
    <div class="task-ask-close-confirm__backdrop" id="task-ask-close-confirm-backdrop"></div>
    <div
      class="task-ask-close-confirm__panel card"
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="task-ask-close-confirm-title"
    >
      <p class="task-ask-close-confirm__detail" id="task-ask-close-confirm-title">
        Закриття втратить контекст Ask, на задачу не вплине. Закрити?
      </p>
      <div class="task-ask-close-confirm__actions">
        <button type="button" class="btn btn--ghost btn--sm" id="task-ask-close-confirm-cancel">Скасувати</button>
        <button type="button" class="btn btn--primary btn--sm" id="task-ask-close-confirm-ok">Закрити</button>
      </div>
    </div>
  </div>
</div>

<script>
  window.__ICLAW_TASK__ = <%- JSON.stringify({ id: task.id, status: task.status, executionChatId: task.execution_chat_id, projectId: task.project_id, syncFingerprint: taskSyncFingerprint }) %>;
</script>
<script src="/js/vendor/marked.min.js"></script>
<script src="/js/vendor/highlight.min.js"></script>
<script src="/js/iclaw.js"></script>

<%- include('partials/foot') %>
