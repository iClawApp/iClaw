<%- include('partials/head', { title: 'Team — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main team-page" data-team-page>
    <header class="chat-header">
      <%- include('partials/mobile-nav-toggle') %>
      <h1 class="team-page-title">
        <% if (selectedSpecialist && selectedProject) { %>
          <a class="team-back" href="/team?projectId=<%= selectedProject.id %>">&lsaquo; <%= selectedProject.name %></a>
        <% } else if (selectedProject) { %>
          <a class="team-back" href="/team">&lsaquo; Team</a>
        <% } else { %>
          Team
        <% } %>
      </h1>
    </header>

    <div class="team-page-body iclaw-thin-scroll"<% if (selectedSpecialist) { %> data-logo-color="<%= selectedSpecialist.color %>"<% } else if (selectedProject) { %> data-logo-color="<%= typeof selectedProject.logo_color === 'number' ? selectedProject.logo_color : 0 %>"<% } %>>
      <%
        function _statusLabel(s) {
          return ({ planning: 'Planning', ready: 'To do', running: 'Doing', needs_review: 'Needs review', needs_human: 'Needs you', needs_clarification: 'Needs you', done: 'Done', failed: 'Failed' })[s] || s;
        }
        function _statusClass(s) {
          if (s === 'running' || s === 'planning') return 'doing';
          if (s === 'needs_review') return 'review';
          if (s === 'needs_human' || s === 'needs_clarification') return 'needs-you';
          if (s === 'done') return 'done';
          if (s === 'failed') return 'failed';
          return 'todo';
        }
        var _tasks = (typeof projectTasks !== 'undefined' && Array.isArray(projectTasks)) ? projectTasks : [];
      %>

      <% if (selectedProject && !selectedSpecialist) {
           var _allP = (typeof projects !== 'undefined' && Array.isArray(projects)) ? projects : [];
           var _ci = _allP.findIndex(function (p) { return p.id === selectedProject.id; });
           var _prevP = _ci > 0 ? _allP[_ci - 1] : null;
           var _nextP = (_ci >= 0 && _ci < _allP.length - 1) ? _allP[_ci + 1] : null;
      %>
      <%# Project "spaces": swipe / ⌘←→ / arrows to switch between projects. %>
      <div class="team-spaces"
           data-prev-url="<%= _prevP ? ('/team?projectId=' + _prevP.id) : '' %>"
           data-next-url="<%= _nextP ? ('/team?projectId=' + _nextP.id) : '' %>">
        <button type="button" class="team-spaces-arrow" data-space-prev aria-label="Previous project"<%= _prevP ? '' : ' disabled' %>>&lsaquo;</button>
        <div class="team-spaces-dots" aria-label="Projects">
          <% _allP.forEach(function (p) { %><a class="team-spaces-dot<%= p.id === selectedProject.id ? ' on' : '' %>" href="/team?projectId=<%= p.id %>" aria-label="<%= p.name %>" title="<%= p.name %>"></a><% }); %>
        </div>
        <button type="button" class="team-spaces-arrow" data-space-next aria-label="Next project"<%= _nextP ? '' : ' disabled' %>>&rsaquo;</button>
      </div>
      <% } %>

      <% if (selectedSpecialist && selectedProject) {
           var _mine = _tasks.filter(function (t) { return t.character_id === selectedSpecialist.id; });
           _mine.sort(function (a, b) { return (b.id || 0) - (a.id || 0); });
      %>
        <%# State 3 — the specialist's own immersive workspace. %>
        <section class="agent">
          <div class="agent-hero">
            <%- include('partials/characterFace', { character: selectedSpecialist, faceClass: 'agent-hero-face' }) %>
            <div class="agent-hero-id">
              <p class="agent-hero-name"><%= selectedSpecialist.name %></p>
              <p class="agent-hero-role"><%= selectedSpecialist.role %></p>
              <% if (Array.isArray(selectedSpecialist.capabilities) && selectedSpecialist.capabilities.length) { %>
              <div class="agent-hero-caps">
                <% selectedSpecialist.capabilities.forEach(function (cap) { %><span class="chat-launcher-cap"><%= cap %></span><% }); %>
              </div>
              <% } %>
            </div>
          </div>

          <form class="brief-form" method="post" action="/projects/<%= selectedProject.id %>/team/<%= selectedSpecialist.id %>/tasks">
            <textarea
              class="brief-field"
              name="goal"
              id="brief-field"
              placeholder="What should <%= selectedSpecialist.name %> handle?"
              required
              autofocus
            ></textarea>
            <div class="brief-bar">
              <span class="brief-hint muted"><%= selectedSpecialist.name %> works it on their own, then comes back for your review.</span>
              <button type="submit" class="btn btn--primary brief-go">Delegate &rarr;</button>
            </div>
          </form>

          <% if (Array.isArray(selectedSpecialist.examples) && selectedSpecialist.examples.length) { %>
          <div class="brief-examples">
            <% selectedSpecialist.examples.forEach(function (ex) { %>
            <button type="button" class="brief-example" data-brief-example><%= ex %></button>
            <% }); %>
          </div>
          <% } %>

          <%# The specialist's own power-up panel (calendar / saved replies),
              keyed per project+specialist so it persists with that agent. %>
          <% if (selectedSpecialist.panel) {
               var _pkey = 'team-' + selectedProject.id + '-' + selectedSpecialist.id;
          %>
            <% if (selectedSpecialist.panel === 'calendar') { %>
            <%- include('partials/panelCalendar', { panelKey: _pkey }) %>
            <% } else if (selectedSpecialist.panel === 'replies') { %>
            <%- include('partials/panelReplies', { panelKey: _pkey }) %>
            <% } %>
          <% } %>

          <% if (_mine.length) { %>
          <div class="agent-tasks">
            <p class="agent-tasks-title"><%= selectedSpecialist.name %>&rsquo;s tasks</p>
            <% _mine.forEach(function (t) { %>
            <a class="agent-task" href="/tasks/<%= t.id %>">
              <span class="team-status team-status--<%= _statusClass(t.status) %>"><%= _statusLabel(t.status) %></span>
              <span class="agent-task-title"><%= t.title %></span>
            </a>
            <% }); %>
          </div>
          <% } %>
        </section>
      <% } else if (selectedProject) { %>
        <%# State 2 — the roster of specialists for the chosen project. %>
        <section class="team-roles">
          <h2 class="team-roles-title">Your team for <%= selectedProject.name %></h2>
          <p class="team-roles-sub muted">Pick a specialist to give them a task. They work it in their own view — you review and approve.</p>
          <div class="team-grid">
            <% (typeof specialists !== 'undefined' ? specialists : []).forEach(function (ch) {
                 var mine = _tasks.filter(function (t) { return t.character_id === ch.id; });
                 mine.sort(function (a, b) { return (b.id || 0) - (a.id || 0); });
                 var current = mine.length ? mine[0] : null;
            %>
            <a class="team-member" href="/team?projectId=<%= selectedProject.id %>&specialist=<%= ch.id %>" data-logo-color="<%= ch.color %>">
              <div class="team-member-head">
                <%- include('partials/characterFace', { character: ch, faceClass: 'team-member-face' }) %>
                <span class="team-member-id">
                  <span class="team-member-name"><%= ch.name %></span>
                  <span class="team-member-role"><%= ch.role %></span>
                </span>
              </div>
              <p class="team-member-tagline muted"><%= ch.tagline %></p>
              <% if (current) { %>
              <span class="team-member-task">
                <span class="team-status team-status--<%= _statusClass(current.status) %>"><%= _statusLabel(current.status) %></span>
                <span class="team-task-title"><%= current.title %></span>
              </span>
              <% } else { %>
              <span class="team-member-cta">Give a task &rarr;</span>
              <% } %>
            </a>
            <% }); %>
          </div>
        </section>
      <% } else { %>
        <%# No projects yet — nothing to staff. (With projects, the route lands
            you straight in the first one; there is no "pick a project" step.) %>
        <section class="team-pick">
          <h2 class="team-pick-title">No projects yet</h2>
          <p class="team-pick-sub muted">Create a project first, then come back to staff its team of specialists.</p>
          <a class="btn btn--primary" href="/projects">Go to projects &rarr;</a>
        </section>
      <% } %>
    </div>
  </main>
</div>

<%- include('partials/foot') %>
<script src="/js/iclaw.js?v=1"></script>
<script>
  (function () {
    var field = document.getElementById('brief-field');
    if (field) {
      document.querySelectorAll('[data-brief-example]').forEach(function (b) {
        b.addEventListener('click', function () {
          field.value = b.textContent.trim();
          field.focus();
        });
      });
    }

    var body = document.querySelector('.team-page-body');
    if (!body) return;
    var bar = document.querySelector('.team-spaces');
    var prevUrl = bar ? bar.getAttribute('data-prev-url') : '';
    var nextUrl = bar ? bar.getAttribute('data-next-url') : '';

    try {
      var d = sessionStorage.getItem('iclaw-space-dir');
      if (d) { body.classList.add(d === 'next' ? 'space-enter-right' : 'space-enter-left'); sessionStorage.removeItem('iclaw-space-dir'); }
    } catch (e) {}

    function nav(url, dir) {
      if (!url) return;
      try { sessionStorage.setItem('iclaw-space-dir', dir); } catch (e) {}
      body.classList.add(dir === 'next' ? 'space-leave-left' : 'space-leave-right');
      setTimeout(function () { window.location.assign(url); }, 160);
    }
    function goPrev() { nav(prevUrl, 'prev'); }
    function goNext() { nav(nextUrl, 'next'); }

    var pb = bar && bar.querySelector('[data-space-prev]');
    if (pb && prevUrl) pb.addEventListener('click', goPrev);
    var nb = bar && bar.querySelector('[data-space-next]');
    if (nb && nextUrl) nb.addEventListener('click', goNext);

    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); goPrev(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); goNext(); }
    });

    var wacc = 0, wt = null;
    body.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      wacc += e.deltaX; clearTimeout(wt); wt = setTimeout(function () { wacc = 0; }, 180);
      if (wacc > 140) { wacc = 0; goNext(); }
      else if (wacc < -140) { wacc = 0; goPrev(); }
    }, { passive: true });

    var sx = null, active = false;
    body.addEventListener('pointerdown', function (e) {
      if (e.target.closest('a,button,textarea,input,select')) return;
      sx = e.clientX; active = true;
    });
    window.addEventListener('pointerup', function (e) {
      if (!active) return; active = false;
      var dx = e.clientX - sx;
      if (dx < -90) goNext(); else if (dx > 90) goPrev();
    });
  })();
</script>
