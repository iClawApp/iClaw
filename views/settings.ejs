<%- include('partials/head', { title: 'Settings — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main settings-page">
    <div class="settings-inner">
      <header class="settings-head">
        <h1 class="settings-title">Settings</h1>
      </header>

      <!-- ─────────── Remote Access ─────────── -->
      <section class="settings-section">
        <header class="settings-section-head">
          <h2 class="settings-section-title">Remote Access</h2>
          <p class="settings-section-desc">
            Open a temporary URL so you can use this iClaw from another device,
            or share access with someone. Each tunnel has its own passphrase
            and expiry — disabling one never affects another.
          </p>
        </header>

        <!-- Create new tunnel -->
        <div class="card settings-create-wrap">
          <form class="ra-form" id="ra-new-form" onsubmit="return false">
            <div class="ra-duration-options" role="radiogroup" aria-label="Duration">
              <% allowedDurationsMs.forEach(function (ms, i) {
                var label =
                  ms === 30 * 60000      ? '30 min' :
                  ms === 12 * 60 * 60000 ? '12 hours' :
                  ms === 7 * 86400000    ? '7 days' :
                  ms === 30 * 86400000   ? '30 days' : (ms + 'ms');
              %>
              <label class="ra-duration-option">
                <input type="radio" name="durationMs" value="<%= ms %>"<%= i === 1 ? ' checked' : '' %> />
                <span><%= label %></span>
              </label>
              <% }); %>
            </div>
            <button type="submit" class="btn btn--primary btn--sm" id="ra-new-btn">Create tunnel</button>
          </form>
        </div>

        <!-- List of active tunnels -->
        <div id="ra-list" class="ra-list">
          <% if (tunnels.length === 0) { %>
            <p class="ra-empty muted">No active tunnels.</p>
          <% } else { %>
            <% tunnels.forEach(function (t) { %>
              <div class="card ra-tunnel-card" data-tunnel-id="<%= t.id %>">
                <div class="ra-tunnel-head">
                  <span class="chip chip--ok">Enabled</span>
                  <span class="ra-tunnel-id muted">#<%= t.id.slice(2, 8) %></span>
                  <span class="ra-remaining muted" data-role="remaining" data-expires-at="<%= t.expiresAt %>">…</span>
                </div>

                <div class="ra-row">
                  <div class="ra-row-label">URL</div>
                  <% if (t.url) { %>
                    <a class="ra-row-value ra-row-link" data-role="url" href="<%= t.url %>" target="_blank" rel="noopener noreferrer"><%= t.url %></a>
                    <button type="button" class="btn btn--ghost btn--sm" data-copy="url">Copy</button>
                  <% } else { %>
                    <span class="ra-row-value ra-connecting muted" data-role="url-pending">Connecting…</span>
                  <% } %>
                </div>

                <div class="ra-row">
                  <div class="ra-row-label">Passphrase</div>
                  <code class="ra-row-value ra-row-mono" data-role="passphrase"><%= t.passphrase %></code>
                  <button type="button" class="btn btn--ghost btn--sm" data-copy="passphrase">Copy</button>
                </div>

                <div class="ra-card-foot">
                  <button type="button" class="btn btn--danger btn--sm" data-action="delete">Disable</button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <p class="settings-fineprint muted">
          The passphrase is the only protection between your iClaw and anyone
          who finds the URL. Share both, or send the link through a private
          channel.
        </p>
      </section>
    </div>
  </main>
</div>

<style>
/* ───────────── Page shell — mirrors projects-hub-page conventions ───────────── */
.settings-page {
  width: 100%;
  max-width: 32rem;
  margin: 0 auto;
  box-sizing: border-box;
  padding: var(--space-9) var(--space-6) var(--space-10);
  overflow-y: auto;
}
.settings-inner { width: 100%; }
.settings-head { margin-bottom: var(--space-7); }
.settings-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--text);
}

/* ───────────── Sections ───────────── */
.settings-section { margin: 0 0 var(--space-9); }
.settings-section:last-child { margin-bottom: 0; }
.settings-section-head { margin: 0 0 var(--space-5); }
.settings-section-title {
  margin: 0 0 var(--space-2);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text);
}
.settings-section-desc {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--muted);
  max-width: 26rem;
}
.settings-fineprint {
  margin: var(--space-4) 0 0;
  font-size: var(--text-xs);
  line-height: 1.55;
  max-width: 26rem;
}

/* ───────────── Create-tunnel form ───────────── */
.settings-create-wrap {
  padding: var(--space-4);
  margin: 0 0 var(--space-4);
  border-left-width: 1px;
}
.ra-form {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.ra-duration-options {
  display: flex;
  gap: var(--space-2);
  flex: 1;
  min-width: 240px;
  flex-wrap: wrap;
}
.ra-duration-option {
  flex: 1;
  min-width: 80px;
}
.ra-duration-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.ra-duration-option span {
  display: block;
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--muted);
  text-align: center;
  cursor: pointer;
  user-select: none;
  transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
}
.ra-duration-option:hover span { color: var(--text); }
.ra-duration-option:has(input[type="radio"]:checked) span {
  color: var(--text);
  background: color-mix(in srgb, var(--accent) 10%, var(--surface));
  border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
}

/* ───────────── Tunnel list ───────────── */
.ra-list { display: flex; flex-direction: column; gap: var(--space-3); }
.ra-empty {
  text-align: center;
  padding: var(--space-6) 0;
  margin: 0;
  font-size: var(--text-sm);
}

.ra-tunnel-card { padding: var(--space-4) var(--space-5); }
.ra-tunnel-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: 0 0 var(--space-4);
}
.ra-tunnel-id {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-xs);
}
.ra-remaining {
  margin-left: auto;
  font-size: var(--text-xs);
  font-variant-numeric: tabular-nums;
}

.ra-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) 0;
  border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
}
.ra-row:first-of-type { border-top: 0; padding-top: 0; }
.ra-row-label {
  flex: 0 0 6rem;
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 500;
}
.ra-row-value {
  flex: 1;
  font-size: var(--text-sm);
  color: var(--text);
  word-break: break-all;
  user-select: all;
  min-width: 0;
}
.ra-row-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
.ra-row-link { color: var(--md-link, var(--accent)); text-decoration: none; }
.ra-row-link:hover { text-decoration: underline; }
.ra-connecting { font-style: italic; }
.ra-connecting::before {
  content: "⟳";
  display: inline-block;
  margin-right: 6px;
  animation: ra-spin 1.4s linear infinite;
}
@keyframes ra-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

.ra-card-foot {
  display: flex;
  justify-content: flex-end;
  padding-top: var(--space-3);
  margin-top: var(--space-2);
  border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
}

@media (max-width: 520px) {
  .settings-page { padding: var(--space-7) var(--space-4) var(--space-8); }
  .ra-form { flex-direction: column; align-items: stretch; }
  .ra-row { flex-wrap: wrap; }
  .ra-row-label { flex-basis: 100%; }
}
</style>

<script>
(function () {
  const list = document.getElementById('ra-list');
  const newForm = document.getElementById('ra-new-form');
  if (!list || !newForm) return;

  function fmtRemaining(ms) {
    if (!ms || ms <= 0) return 'expired';
    const sec = Math.floor(ms / 1000);
    const min = Math.floor(sec / 60);
    const hr  = Math.floor(min / 60);
    const day = Math.floor(hr / 24);
    if (day >= 1) return day + 'd ' + (hr % 24) + 'h';
    if (hr  >= 1) return hr  + 'h ' + (min % 60) + 'm';
    if (min >= 1) return min + 'm ' + (sec % 60) + 's';
    return sec + 's';
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;';
    });
  }
  async function copy(text, btn) {
    try { await navigator.clipboard.writeText(text); }
    catch (e) { console.warn('clipboard write failed', e); return; }
    if (!btn) return;
    const orig = btn.textContent;
    btn.textContent = 'Copied';
    btn.disabled = true;
    setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 1100);
  }

  function renderCard(t) {
    const idShort = t.id.slice(2, 8);
    const urlBlock = t.url
      ? '<a class="ra-row-value ra-row-link" data-role="url" href="' + escapeHtml(t.url) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(t.url) + '</a>' +
        '<button type="button" class="btn btn--ghost btn--sm" data-copy="url">Copy</button>'
      : '<span class="ra-row-value ra-connecting muted" data-role="url-pending">Connecting…</span>';

    return '<div class="card ra-tunnel-card" data-tunnel-id="' + escapeHtml(t.id) + '">' +
      '  <div class="ra-tunnel-head">' +
      '    <span class="chip chip--ok">Enabled</span>' +
      '    <span class="ra-tunnel-id muted">#' + escapeHtml(idShort) + '</span>' +
      '    <span class="ra-remaining muted" data-role="remaining" data-expires-at="' + t.expiresAt + '">' + fmtRemaining(t.expiresAt - Date.now()) + '</span>' +
      '  </div>' +
      '  <div class="ra-row">' +
      '    <div class="ra-row-label">URL</div>' +
      '    ' + urlBlock +
      '  </div>' +
      '  <div class="ra-row">' +
      '    <div class="ra-row-label">Passphrase</div>' +
      '    <code class="ra-row-value ra-row-mono" data-role="passphrase">' + escapeHtml(t.passphrase) + '</code>' +
      '    <button type="button" class="btn btn--ghost btn--sm" data-copy="passphrase">Copy</button>' +
      '  </div>' +
      '  <div class="ra-card-foot">' +
      '    <button type="button" class="btn btn--danger btn--sm" data-action="delete">Disable</button>' +
      '  </div>' +
      '</div>';
  }

  function renderList(tunnels) {
    if (!tunnels || tunnels.length === 0) {
      list.innerHTML = '<p class="ra-empty muted">No active tunnels.</p>';
      return;
    }
    list.innerHTML = tunnels.map(renderCard).join('');
  }

  function tickRemaining() {
    const now = Date.now();
    list.querySelectorAll('[data-role="remaining"]').forEach(function (el) {
      const at = Number(el.getAttribute('data-expires-at'));
      if (!at) return;
      el.textContent = fmtRemaining(at - now);
    });
  }

  async function fetchStatus() {
    const res = await fetch('/api/remote-access/tunnels');
    if (!res.ok) return null;
    return res.json();
  }

  let pollTimer = null;
  function startPolling() { if (!pollTimer) pollTimer = setInterval(poll, 1500); }
  function stopPolling()  { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } }
  async function poll() {
    if (document.hidden) return;
    const data = await fetchStatus();
    if (!data) return;
    renderList(data.tunnels);
    tickRemaining();
  }
  setInterval(tickRemaining, 1000);

  list.addEventListener('click', async function (e) {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;

    if (t.hasAttribute('data-copy')) {
      const role = t.getAttribute('data-copy');
      const card = t.closest('[data-tunnel-id]');
      if (!card) return;
      const valueEl = card.querySelector('[data-role="' + role + '"]');
      if (valueEl) copy((valueEl.textContent || '').trim(), t);
      return;
    }

    if (t.getAttribute('data-action') === 'delete') {
      const card = t.closest('[data-tunnel-id]');
      if (!card) return;
      const id = card.getAttribute('data-tunnel-id');
      if (!id) return;
      if (!confirm('Disable this tunnel? Anyone currently connected through it will be cut off.')) return;
      t.disabled = true;
      const orig = t.textContent;
      t.textContent = 'Disabling…';
      try {
        const res = await fetch('/api/remote-access/tunnels/' + encodeURIComponent(id), { method: 'DELETE' });
        if (!res.ok) {
          alert('Failed to disable');
          t.disabled = false;
          t.textContent = orig;
          return;
        }
        await poll();
      } catch (e2) {
        alert('Failed to disable: ' + e2.message);
        t.disabled = false;
        t.textContent = orig;
      }
    }
  });

  newForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const btn = document.getElementById('ra-new-btn');
    const checked = newForm.querySelector('input[name="durationMs"]:checked');
    if (!checked) return;
    const durationMs = Number(checked.value);
    btn.disabled = true;
    const orig = btn.textContent;
    btn.textContent = 'Creating…';
    try {
      const res = await fetch('/api/remote-access/tunnels', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ durationMs }),
      });
      if (!res.ok) {
        const err = await res.json().catch(function () { return { error: 'failed' }; });
        alert('Failed to create: ' + (err.error || res.status));
      } else {
        await poll();
      }
    } catch (e3) {
      alert('Failed to create: ' + e3.message);
    } finally {
      btn.disabled = false;
      btn.textContent = orig;
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopPolling();
    else startPolling();
  });

  startPolling();
})();
</script>

<%- include('partials/foot') %>
