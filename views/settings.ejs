  padding: 0;
  min-width: 0;
}

/* iOS-style inset grouped row (Name) */
.ra-modal-group {
  border-radius: var(--radius-lg);
  background: color-mix(in srgb, var(--text) 5%, var(--surface));
  overflow: clip;
}
.ra-modal-group-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  min-height: 44px;
  padding: 0 var(--space-5);
