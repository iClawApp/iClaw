}
.ra-modal-group-label {
  flex: 0 0 auto;
  font-size: var(--text-sm);
  color: var(--text);
  letter-spacing: -0.01em;
}
.ra-modal-group-input {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
  padding: var(--space-4) 0;
  border: 0;
