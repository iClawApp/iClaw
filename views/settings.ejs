<%- include('partials/head', { title: 'Settings — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main settings-page">
    <div class="settings-inner">
      <header class="settings-head page-toolbar">
        <%- include('partials/mobile-nav-toggle') %>
        <h1 class="settings-title">Settings</h1>
      </header>

      <nav class="settings-tabs" aria-label="Settings sections">
        <a class="settings-tab<%= settingsTab === 'voice-ask' ? ' is-active' : '' %>" href="/settings/voice-ask"<%- settingsTab === 'voice-ask' ? ' aria-current="page"' : '' %>>Voice</a>
        <a class="settings-tab<%= settingsTab === 'remote-access' ? ' is-active' : '' %>" href="/settings/remote-access"<%- settingsTab === 'remote-access' ? ' aria-current="page"' : '' %>>Remote Access</a>
      </nav>

      <% if (settingsTab === 'voice-ask') { %>
      <!-- ─────────── Voice (OpenRouter) ─────────── -->
      <section class="settings-section">
        <header class="settings-section-head">
          <div class="settings-section-head-text">
            <h2 class="settings-section-title">
              <svg class="settings-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/><path d="M5 3v4"/><path d="M3 5h4"/>
              </svg>
              Voice
            </h2>
            <p class="settings-section-desc">
              Paste your OpenRouter key to unlock:
            </p>
            <ul class="settings-section-feature-list">
              <li>🎙 <strong>Voice messages</strong> — speak instead of type</li>
              <li>🗂 <strong>Work mode</strong> — AI works inside your selected folders only, file writes need your approval</li>
              <li>✏️ <strong>Auto-named chats</strong> — titles generated automatically</li>
            </ul>
            <p class="settings-section-desc settings-section-desc--sub">The key stays on this device.</p>
          </div>
        </header>

        <% if (openRouter.hasKey) { %>
          <div class="or-card" id="or-card">
            <div class="or-status-row">
              <span class="or-dot" aria-hidden="true"></span>
              <div class="or-status-text">
                <div class="or-status-title">Connected</div>
                <code class="or-key"><%= openRouter.maskedKey %></code>
              </div>
              <button type="button" class="btn btn--ghost btn--sm btn--danger" id="or-disconnect">Disconnect</button>
            </div>
            <div class="or-usage" id="or-usage">
              <div class="or-usage-loading">
                <span class="ra-spinner" aria-hidden="true"></span><span>Loading usage…</span>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="or-card or-connect" id="or-card">
            <form class="or-form" id="or-form">
              <input
                type="password"
                id="or-key-input"
                class="or-input"
                placeholder="Paste your key (sk-or-…)"
                autocomplete="off"
                spellcheck="false"
                aria-label="OpenRouter API key"
              />
              <button type="submit" class="btn btn--primary btn--sm" id="or-connect">Connect</button>
            </form>
            <p class="or-err" id="or-err" role="alert" hidden></p>
            <a class="or-help" href="https://openrouter.ai/keys" target="_blank" rel="noopener noreferrer">
              Don’t have a key? Get one at openrouter.ai/keys
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          </div>
        <% } %>
      </section>
      <% } %>

      <% if (settingsTab === 'remote-access') { %>
      <!-- ─────────── Remote Access ─────────── -->
      <section class="settings-section">
        <header class="settings-section-head">
          <div class="settings-section-head-row">
            <div class="settings-section-head-text">
              <h2 class="settings-section-title">
                <svg class="settings-section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                Remote Access
              </h2>
              <p class="settings-section-desc">
                Get a link to open iClaw on your phone, another computer, or
                with someone you trust. Each link has its own passphrase and
                stops working when the time runs out.
              </p>
            </div>
            <button type="button" class="btn btn--primary btn--sm ra-new-btn" id="ra-open-modal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <span>Share</span>
            </button>
          </div>
        </header>

        <!-- List of active tunnels -->
        <div id="ra-list" class="ra-list">
          <% if (tunnels.length === 0) { %>
            <div class="ra-empty">
              <svg class="ra-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              <p class="ra-empty-text">No active tunnels</p>
            </div>
          <% } else { %>
            <% tunnels.forEach(function (t) {
              var tunnelTitle = t.label || 'Remote tunnel';
              var passMask = '•'.repeat(Math.max(t.passphrase.length, 8));
              var urlHost = '', urlPath = '';
              if (t.url) {
                try {
                  var u = new URL(t.url);
                  urlHost = u.host;
                  urlPath = u.pathname + u.search + u.hash;
                } catch (e) {
                  urlHost = t.url;
                }
              }
            %>
              <div
                class="ra-tunnel-card"
                data-tunnel-id="<%= t.id %>"
                data-expires-at="<%= t.expiresAt %>"
              >
                <div class="ra-tunnel-head">
                  <div class="ra-tunnel-meta">
                    <h3 class="ra-tunnel-name"><%= tunnelTitle %></h3>
                    <span class="ra-remaining" data-role="remaining">…</span>
                  </div>
                  <button type="button" class="btn btn--ghost btn--sm btn--danger ra-disable-btn" data-action="delete">Disable</button>
                </div>

                <div class="ra-field">
                  <div class="ra-field-label">URL</div>
                  <% if (t.url) { %>
                    <div class="ra-field-value-row">
                      <a class="ra-url" data-role="url" href="<%= t.url %>" target="_blank" rel="noopener noreferrer" title="<%= t.url %>">
                        <span class="ra-url-display">
                          <span class="ra-url-host"><%= urlHost %></span><% if (urlPath) { %><span class="ra-url-path"><%= urlPath %></span><% } %>
                        </span>
                      </a>
                      <button type="button" class="ra-copy-btn btn btn--icon btn--ghost" data-copy="url" aria-label="Copy access link" title="Copy access link">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                      </button>
                      <button type="button" class="btn btn--ghost btn--sm" data-action="regenerate-access" title="Invalidate old links and mint a new access token">New access link</button>
                    </div>
                  <% } else { %>
                    <div class="ra-connecting" data-role="url-pending">
                      <span class="ra-spinner" aria-hidden="true"></span>
                      <span>Connecting…</span>
                    </div>
                  <% } %>
                </div>

                <div class="ra-field">
                  <div class="ra-field-label">Passphrase</div>
                  <div class="ra-field-value-row">
                    <code class="ra-passphrase is-masked" data-role="passphrase" data-secret="<%= t.passphrase %>" tabindex="0" role="button" aria-label="Show passphrase"><%= passMask %></code>
                    <button type="button" class="ra-copy-btn btn btn--icon btn--ghost" data-copy="passphrase" aria-label="Copy passphrase" title="Copy passphrase">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="ra-field ra-devices-field" data-role="devices-wrap" data-tunnel-id="<%= t.id %>">
                  <div class="ra-field-label">Connected devices</div>
                  <div class="ra-devices-list" data-role="devices-list">
                    <span class="ra-devices-muted">Loading…</span>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </section>
      <% } %>
    </div>
  </main>
</div>

<% if (settingsTab === 'remote-access') { %>
<!-- ─────────── New-tunnel modal ─────────── -->
<dialog id="ra-modal" class="ra-modal" aria-labelledby="ra-modal-title" aria-describedby="ra-modal-desc">
  <form method="dialog" class="ra-modal-form" id="ra-modal-form">
    <header class="ra-modal-head">
      <div class="ra-modal-head-text">
        <h3 class="ra-modal-title" id="ra-modal-title">Share</h3>
        <p class="ra-modal-lead" id="ra-modal-desc">
          Get a link and password for another device or someone you trust
        </p>
      </div>
      <button type="button" class="ra-modal-x" id="ra-modal-cancel" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>

    <div class="ra-modal-body">
      <div class="ra-modal-group">
        <label class="ra-modal-group-row" for="ra-modal-label">
          <span class="ra-modal-group-label">Name</span>
          <input
            type="text"
            name="label"
            id="ra-modal-label"
            class="ra-modal-group-input"
            placeholder="Anna's iPhone"
            maxlength="64"
            autocomplete="off"
            required
          />
        </label>
      </div>

      <fieldset class="ra-modal-field ra-duration-field">
        <legend class="ra-duration-legend">Expires after</legend>
        <div class="ra-duration-segmented" role="radiogroup" aria-label="Expires after">
          <% allowedDurationsMs.forEach(function (ms, i) {
            var label;
            var title;
            if      (ms === 30 * 60000)      { label = '30m';  title = '30 minutes'; }
            else if (ms === 12 * 60 * 60000) { label = '12h';  title = '12 hours'; }
            else if (ms === 7 * 86400000)    { label = '7d';   title = '7 days'; }
            else if (ms === 30 * 86400000)   { label = '30d';  title = '30 days'; }
            else                              { label = Math.round(ms / 60000) + 'm'; title = label; }
          %>
          <label class="ra-duration-seg">
            <input type="radio" name="durationMs" value="<%= ms %>"<%= i === 1 ? ' checked' : '' %> />
            <span class="ra-duration-seg-label" title="<%= title %>"><%= label %></span>
          </label>
          <% }); %>
        </div>
      </fieldset>
    </div>

    <footer class="ra-modal-foot">
      <button type="submit" class="btn btn--primary btn--sm" id="ra-modal-submit">Share</button>
    </footer>
  </form>
</dialog>
<% } %>

<style>
/* ───────────── Page shell ───────────── */
.settings-page {
  width: 100%;
  max-width: 42rem;
  margin: 0 auto;
  box-sizing: border-box;
  padding: var(--space-9) var(--space-6) var(--space-10);
  overflow-y: auto;
}
.settings-inner { width: 100%; }
.settings-head { margin-bottom: var(--space-6); }
.settings-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--text);
}

/* ───────────── Section tabs (each its own page) ───────────── */
.settings-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin: 0 0 var(--space-8);
}
.settings-tab {
  display: inline-flex;
  align-items: center;
  padding: var(--space-3) var(--space-6);
  border-radius: var(--radius-pill);
  border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  background: var(--surface);
  color: var(--muted);
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: -0.01em;
  text-decoration: none;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}
.settings-tab:hover {
  color: var(--text);
  border-color: color-mix(in srgb, var(--text) 22%, var(--border));
}
.settings-tab.is-active {
  color: var(--btn-fg);
  background: var(--btn-bg);
  border-color: var(--btn-bg);
}

/* ───────────── Section ───────────── */
.settings-section { margin: 0 0 var(--space-9); }
.settings-section-head { margin: 0 0 var(--space-5); }
.settings-section-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
}
.settings-section-head-text { flex: 1; min-width: 0; }
.settings-section-title {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: 0 0 var(--space-2);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text);
}
.settings-section-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: color-mix(in srgb, var(--muted) 70%, var(--text));
}
.settings-section-desc {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--muted);
  max-width: 26rem;
}
.settings-section-desc--sub {
  margin-top: var(--space-2);
}
.settings-section-feature-list {
  margin: var(--space-2) 0 0;
  padding-left: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  font-size: var(--text-sm);
  color: var(--muted);
  max-width: 26rem;
}
.settings-section-feature-list li {
  line-height: 1.45;
}
.ra-new-btn {
  flex-shrink: 0;
  gap: var(--space-2);
}
.ra-new-btn svg { width: 14px; height: 14px; display: block; }

/* ───────────── Tunnel cards list ───────────── */
.ra-list { display: flex; flex-direction: column; gap: var(--space-3); }

.ra-tunnel-card {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-5) var(--space-4);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.ra-tunnel-card:hover {
  border-color: color-mix(in srgb, var(--border) 100%, transparent);
  box-shadow: 0 1px 0 color-mix(in srgb, var(--text) 4%, transparent);
}

.ra-tunnel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  margin: 0 0 var(--space-5);
}
.ra-tunnel-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: var(--space-2) var(--space-4);
}
.ra-tunnel-name {
  margin: 0;
  font-size: var(--text-sm);
  font-weight: 600;
  letter-spacing: -0.015em;
  color: var(--text);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ra-remaining {
  font-size: var(--text-xs);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.ra-disable-btn {
  flex-shrink: 0;
}

/* Field rows */
.ra-field { margin: 0 0 var(--space-3); }
.ra-field:last-of-type { margin-bottom: 0; }
.ra-field-label {
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 500;
  margin: 0 0 var(--space-2);
}
.ra-field-value-row {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.ra-url {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  min-width: 0;
  padding: 0;
  background: none;
  border: none;
  color: var(--md-link, var(--accent));
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-sm);
  text-decoration: none;
  user-select: all;
}
.ra-url:hover {
  text-decoration: underline;
  text-underline-offset: 2px;
}
.ra-url-display {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ra-url-host {
  font-weight: 600;
  color: inherit;
}
.ra-url-path {
  color: color-mix(in srgb, currentColor 72%, transparent);
  font-weight: 400;
}
.ra-connecting {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--muted);
  font-style: italic;
}
.ra-spinner {
  width: 12px; height: 12px;
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--muted) 30%, transparent);
  border-top-color: var(--muted);
  animation: ra-spin 0.9s linear infinite;
}
@keyframes ra-spin { to { transform: rotate(360deg); } }

.ra-passphrase {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  background: none;
  border: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-sm);
  color: var(--text);
  word-break: break-all;
  letter-spacing: 0.01em;
  cursor: pointer;
}
.ra-passphrase.is-masked {
  user-select: none;
  color: var(--muted);
  letter-spacing: 0.12em;
}
.ra-passphrase:not(.is-masked) { user-select: all; }
.ra-passphrase:focus-visible {
  outline: none;
  border-radius: var(--radius-xs);
  box-shadow: var(--focus-ring);
}

/* Copy buttons */
.ra-copy-btn {
  flex-shrink: 0;
  --_btn-pad-y: 0;
  --_btn-pad-x: 0;
  --_btn-border: transparent;
  --_btn-bg: transparent;
  width: 28px;
  height: 28px;
  opacity: 0.55;
}
.ra-field-value-row:hover .ra-copy-btn,
.ra-copy-btn:hover,
.ra-copy-btn:focus-visible {
  opacity: 1;
}
.ra-copy-btn svg { width: 14px; height: 14px; display: block; }
.ra-copy-btn.is-copied {
  color: var(--ok, #2ea043);
  --_btn-border: color-mix(in srgb, var(--ok, #2ea043) 35%, var(--border));
  --_btn-bg: color-mix(in srgb, var(--ok, #2ea043) 10%, transparent);
}

/* ───────────── Empty state ───────────── */
.ra-empty {
  text-align: center;
  padding: var(--space-9) var(--space-5);
  border: 1px dashed color-mix(in srgb, var(--border) 60%, transparent);
  border-radius: var(--radius-lg);
  color: var(--muted);
}
.ra-empty-icon {
  width: 32px; height: 32px;
  display: block;
  margin: 0 auto var(--space-3);
  color: color-mix(in srgb, var(--muted) 55%, transparent);
}
.ra-empty-text {
  margin: 0;
  font-size: var(--text-sm);
  color: var(--text);
  font-weight: 500;
}

.ra-devices-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.ra-device-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  background: color-mix(in srgb, var(--text) 4%, var(--surface));
  font-size: var(--text-sm);
}
.ra-device-row.is-revoked { opacity: 0.55; }
.ra-device-meta { flex: 1; min-width: 0; }
.ra-device-name {
  font-weight: 500;
  color: var(--text);
  word-break: break-word;
}
.ra-device-sub {
  margin-top: 2px;
  font-size: 0.8rem;
  color: var(--muted);
  line-height: 1.35;
}
.ra-devices-muted {
  font-size: var(--text-sm);
  color: var(--muted);
}

/* ───────────── Modal ───────────── */
.ra-modal {
  padding: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  color: var(--text);
  max-width: 28rem;
  width: calc(100% - 32px);
  box-shadow:
    0 1px 0 color-mix(in srgb, #fff 4%, transparent) inset,
    0 24px 80px color-mix(in srgb, #000 50%, transparent),
    0 4px 12px color-mix(in srgb, #000 30%, transparent);
}
.ra-modal::backdrop {
  background: color-mix(in srgb, #000 55%, transparent);
  backdrop-filter: blur(6px);
}
.ra-modal[open] { animation: ra-modal-in 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
@keyframes ra-modal-in {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0)    scale(1); }
}
.ra-modal-form {
  display: flex;
  flex-direction: column;
  margin: 0;
}
.ra-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-6) var(--space-5) var(--space-5);
  border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
}
.ra-modal-head-text { flex: 1; min-width: 0; }
.ra-modal-title {
  margin: 0 0 var(--space-2);
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
