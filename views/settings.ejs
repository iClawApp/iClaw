}
.or-usage-label { margin-top: 3px; font-size: var(--text-xs); color: var(--muted); }
.or-bar {
  margin-top: var(--space-5);
  height: 5px;
  border-radius: var(--radius-pill);
  background: color-mix(in srgb, var(--text) 9%, transparent);
