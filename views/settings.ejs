<%- include('partials/head', { title: 'Settings — iClaw' }) %>

<div class="app">
  <%- include('partials/sidebar') %>

  <main class="col col-main settings-page">
    <div class="settings-inner">
      <header class="settings-head">
        <h1 class="settings-title">Settings</h1>
      </header>

      <!-- ─────────── Remote Access ─────────── -->
      <section class="settings-section">
        <header class="settings-section-head">
          <div class="settings-section-head-row">
            <div class="settings-section-head-text">
              <h2 class="settings-section-title">Remote Access</h2>
              <p class="settings-section-desc">
                Open a temporary URL so you can use this iClaw from another
                device, or share access with someone. Each tunnel has its own
                passphrase and expiry.
              </p>
            </div>
            <button type="button" class="btn btn--primary btn--sm ra-new-btn" id="ra-open-modal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <span>New tunnel</span>
            </button>
          </div>
        </header>

        <!-- List of active tunnels -->
        <div id="ra-list" class="ra-list">
          <% if (tunnels.length === 0) { %>
            <div class="ra-empty">
              <svg class="ra-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
              <p class="ra-empty-text">No active tunnels.</p>
              <p class="ra-empty-hint">Click <strong>New tunnel</strong> to share access from another device.</p>
            </div>
          <% } else { %>
            <% tunnels.forEach(function (t) { %>
              <div class="ra-tunnel-card" data-tunnel-id="<%= t.id %>">
                <div class="ra-tunnel-head">
                  <span class="ra-status">
                    <span class="ra-status-dot" aria-hidden="true"></span>
                    <span class="ra-status-text">Live</span>
                  </span>
                  <% if (t.label) { %>
                    <span class="ra-tunnel-label"><%= t.label %></span>
                  <% } %>
                  <span class="ra-remaining" data-role="remaining" data-expires-at="<%= t.expiresAt %>">…</span>
                </div>

                <div class="ra-field">
                  <div class="ra-field-label">URL</div>
                  <% if (t.url) { %>
                    <div class="ra-field-value-row">
                      <a class="ra-url" data-role="url" href="<%= t.url %>" target="_blank" rel="noopener noreferrer">
                        <span class="ra-url-text"><%= t.url %></span>
                        <svg class="ra-extlink-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                          <polyline points="15 3 21 3 21 9"/>
                          <line x1="10" y1="14" x2="21" y2="3"/>
                        </svg>
                      </a>
                      <button type="button" class="ra-copy-btn" data-copy="url" aria-label="Copy URL" title="Copy URL">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                      </button>
                    </div>
                  <% } else { %>
                    <div class="ra-connecting" data-role="url-pending">
                      <span class="ra-spinner" aria-hidden="true"></span>
                      <span>Connecting…</span>
                    </div>
                  <% } %>
                </div>

                <div class="ra-field">
                  <div class="ra-field-label">Passphrase</div>
                  <div class="ra-field-value-row">
                    <code class="ra-passphrase" data-role="passphrase"><%= t.passphrase %></code>
                    <button type="button" class="ra-copy-btn" data-copy="passphrase" aria-label="Copy passphrase" title="Copy passphrase">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="ra-card-foot">
                  <button type="button" class="ra-disable-link" data-action="delete">Disable</button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <p class="settings-fineprint">
          The passphrase is the only protection between your iClaw and anyone
          who finds the URL. Share both, or send the link through a private
          channel.
        </p>
      </section>
    </div>
  </main>
</div>

<!-- ─────────── New-tunnel modal ─────────── -->
<dialog id="ra-modal" class="ra-modal" aria-labelledby="ra-modal-title">
  <form method="dialog" class="ra-modal-form" id="ra-modal-form">
    <header class="ra-modal-head">
      <div class="ra-modal-head-text">
        <h3 class="ra-modal-title" id="ra-modal-title">New tunnel</h3>
        <p class="ra-modal-subtitle">Generates a temporary URL and passphrase for someone to reach this iClaw.</p>
      </div>
      <button type="button" class="ra-modal-x" id="ra-modal-cancel" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </header>

    <div class="ra-modal-body">
      <label class="ra-modal-field">
        <span class="ra-modal-field-label">
          Name
          <span class="ra-modal-field-hint">optional · helps you remember who this is for</span>
        </span>
        <input
          type="text"
          name="label"
          id="ra-modal-label"
          class="ra-modal-input"
          placeholder="e.g. Anna's iPhone, work laptop"
          maxlength="64"
          autocomplete="off"
        />
      </label>

      <fieldset class="ra-modal-field">
        <legend class="ra-modal-field-label">
          Expires after
          <span class="ra-modal-field-hint">tunnel auto-closes when time runs out</span>
        </legend>
        <div class="ra-duration-options" role="radiogroup">
          <% allowedDurationsMs.forEach(function (ms, i) {
            var label, hint;
            if      (ms === 30 * 60000)      { label = '30 min';  hint = 'quick share'; }
            else if (ms === 12 * 60 * 60000) { label = '12 hours'; hint = 'today'; }
            else if (ms === 7 * 86400000)    { label = '7 days';   hint = 'this week'; }
            else if (ms === 30 * 86400000)   { label = '30 days';  hint = 'long-term'; }
            else                              { label = ms + 'ms'; hint = ''; }
          %>
          <label class="ra-duration-option">
            <input type="radio" name="durationMs" value="<%= ms %>"<%= i === 1 ? ' checked' : '' %> />
            <span class="ra-duration-content">
              <span class="ra-duration-main"><%= label %></span>
              <% if (hint) { %><span class="ra-duration-hint"><%= hint %></span><% } %>
            </span>
            <svg class="ra-duration-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </label>
          <% }); %>
        </div>
      </fieldset>
    </div>

    <footer class="ra-modal-foot">
      <button type="button" class="btn btn--ghost btn--sm" id="ra-modal-cancel2">Cancel</button>
      <button type="submit" class="btn btn--primary btn--sm" id="ra-modal-submit">Create tunnel</button>
    </footer>
  </form>
</dialog>

<style>
/* ───────────── Page shell ───────────── */
.settings-page {
  width: 100%;
  max-width: 36rem;
  margin: 0 auto;
  box-sizing: border-box;
  padding: var(--space-9) var(--space-6) var(--space-10);
  overflow-y: auto;
}
.settings-inner { width: 100%; }
.settings-head { margin-bottom: var(--space-7); }
.settings-title {
  margin: 0;
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--text);
}

/* ───────────── Section ───────────── */
.settings-section { margin: 0 0 var(--space-9); }
.settings-section-head { margin: 0 0 var(--space-5); }
.settings-section-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
}
.settings-section-head-text { flex: 1; min-width: 0; }
.settings-section-title {
  margin: 0 0 var(--space-2);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--text);
}
.settings-section-desc {
  margin: 0;
  font-size: var(--text-sm);
  line-height: 1.55;
  color: var(--muted);
  max-width: 26rem;
}
.settings-fineprint {
  margin: var(--space-4) 0 0;
  font-size: var(--text-xs);
  line-height: 1.55;
  color: var(--muted);
  max-width: 28rem;
}
.ra-new-btn {
  flex-shrink: 0;
  gap: var(--space-2);
}
.ra-new-btn svg { width: 14px; height: 14px; display: block; }

/* ───────────── Tunnel cards list ───────────── */
.ra-list { display: flex; flex-direction: column; gap: var(--space-3); }

.ra-tunnel-card {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  border-radius: var(--radius-lg);
  padding: var(--space-5) var(--space-5) var(--space-4);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.ra-tunnel-card:hover {
  border-color: color-mix(in srgb, var(--border) 100%, transparent);
  box-shadow: 0 1px 0 color-mix(in srgb, var(--text) 4%, transparent);
}

.ra-tunnel-head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: 0 0 var(--space-4);
  flex-wrap: wrap;
}
.ra-status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-xs);
  color: var(--ok, #2ea043);
  font-weight: 500;
}
.ra-status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: currentColor;
  animation: ra-pulse 2.2s ease-in-out infinite;
}
@keyframes ra-pulse {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, currentColor 50%, transparent); }
  50%      { box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 0%, transparent); }
}
.ra-tunnel-label {
  font-size: var(--text-sm);
  color: var(--text);
  font-weight: 500;
  letter-spacing: -0.005em;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 14rem;
}
.ra-remaining {
  margin-left: auto;
  font-size: var(--text-xs);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* Field rows */
.ra-field { margin: 0 0 var(--space-3); }
.ra-field:last-of-type { margin-bottom: 0; }
.ra-field-label {
  font-size: var(--text-xs);
  color: var(--muted);
  font-weight: 500;
  margin: 0 0 var(--space-2);
}
.ra-field-value-row {
  display: flex;
  align-items: stretch;
  gap: var(--space-2);
}

.ra-url {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex: 1;
  min-width: 0;
  padding: var(--space-3) var(--space-4);
  background: color-mix(in srgb, var(--text) 3%, transparent);
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: var(--radius-md);
  color: var(--text);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-sm);
  text-decoration: none;
  user-select: all;
  transition: background 0.12s ease, border-color 0.12s ease;
}
.ra-url:hover {
  background: color-mix(in srgb, var(--text) 6%, transparent);
  border-color: color-mix(in srgb, var(--border) 100%, transparent);
}
.ra-url-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ra-extlink-icon {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
  color: color-mix(in srgb, var(--text) 40%, transparent);
}
.ra-url:hover .ra-extlink-icon { color: var(--md-link, var(--accent)); }

.ra-connecting {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-3) var(--space-4);
  background: color-mix(in srgb, var(--text) 2%, transparent);
  border: 1px dashed color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  color: var(--muted);
  font-style: italic;
}
.ra-spinner {
  width: 12px; height: 12px;
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--muted) 30%, transparent);
  border-top-color: var(--muted);
  animation: ra-spin 0.9s linear infinite;
}
@keyframes ra-spin { to { transform: rotate(360deg); } }

.ra-passphrase {
  flex: 1;
  min-width: 0;
  padding: var(--space-3) var(--space-4);
  background: color-mix(in srgb, var(--text) 3%, transparent);
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: var(--radius-md);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-sm);
  color: var(--text);
  user-select: all;
  word-break: break-all;
  letter-spacing: 0.01em;
}

/* Copy buttons */
.ra-copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  padding: 0;
  border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  flex-shrink: 0;
  transition: color 0.12s ease, background 0.12s ease, border-color 0.12s ease;
}
.ra-copy-btn svg { width: 14px; height: 14px; display: block; }
.ra-copy-btn:hover {
  color: var(--text);
  background: color-mix(in srgb, var(--text) 5%, transparent);
}
.ra-copy-btn.is-copied {
  color: var(--ok, #2ea043);
  border-color: color-mix(in srgb, var(--ok, #2ea043) 30%, transparent);
  background: color-mix(in srgb, var(--ok, #2ea043) 10%, transparent);
}
.ra-copy-btn:disabled { cursor: default; }

/* Card foot */
.ra-card-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: var(--space-3);
}
.ra-disable-link {
  appearance: none;
  background: transparent;
  border: 0;
  padding: var(--space-1) 0;
  color: var(--muted);
  font-size: var(--text-xs);
  font-weight: 500;
  cursor: pointer;
  transition: color 0.12s ease;
}
.ra-disable-link:hover { color: var(--danger); }
.ra-disable-link:disabled { color: var(--muted); cursor: default; }

/* ───────────── Empty state ───────────── */
.ra-empty {
  text-align: center;
  padding: var(--space-9) var(--space-5);
  border: 1px dashed color-mix(in srgb, var(--border) 60%, transparent);
  border-radius: var(--radius-lg);
  color: var(--muted);
}
.ra-empty-icon {
  width: 32px; height: 32px;
  display: block;
  margin: 0 auto var(--space-3);
  color: color-mix(in srgb, var(--muted) 55%, transparent);
}
.ra-empty-text {
  margin: 0 0 var(--space-1);
  font-size: var(--text-sm);
  color: var(--text);
  font-weight: 500;
}
.ra-empty-hint { margin: 0; font-size: var(--text-xs); }
.ra-empty-hint strong { color: var(--text); font-weight: 500; }

/* ───────────── Modal ───────────── */
.ra-modal {
  padding: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  color: var(--text);
  max-width: 28rem;
  width: calc(100% - 32px);
  box-shadow:
    0 1px 0 color-mix(in srgb, #fff 4%, transparent) inset,
    0 24px 80px color-mix(in srgb, #000 50%, transparent),
    0 4px 12px color-mix(in srgb, #000 30%, transparent);
}
.ra-modal::backdrop {
  background: color-mix(in srgb, #000 55%, transparent);
  backdrop-filter: blur(6px);
}
.ra-modal[open] { animation: ra-modal-in 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
@keyframes ra-modal-in {
  from { opacity: 0; transform: translateY(12px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0)    scale(1); }
}
.ra-modal-form {
  display: flex;
  flex-direction: column;
  margin: 0;
}
.ra-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-5) var(--space-5) var(--space-4);
}
.ra-modal-head-text { flex: 1; min-width: 0; }
.ra-modal-title {
  margin: 0 0 var(--space-1);
  font-size: 1.05rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.25;
}
.ra-modal-subtitle {
  margin: 0;
  font-size: var(--text-xs);
  color: var(--muted);
  line-height: 1.5;
}
.ra-modal-x {
  appearance: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  flex-shrink: 0;
  transition: color 0.12s ease, background 0.12s ease;
}
.ra-modal-x svg { width: 16px; height: 16px; display: block; }
.ra-modal-x:hover { color: var(--text); background: color-mix(in srgb, var(--text) 6%, transparent); }

.ra-modal-body {
  padding: var(--space-2) var(--space-5) var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}
.ra-modal-field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  border: 0;
  margin: 0;
  padding: 0;
}
.ra-modal-field-label {
  font-size: var(--text-xs);
  font-weight: 600;
  color: var(--text);
  padding: 0;
  letter-spacing: -0.005em;
}
.ra-modal-field-hint {
  font-weight: 400;
  margin-left: var(--space-2);
  color: var(--muted);
  font-size: 11px;
}
.ra-modal-input {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: color-mix(in srgb, var(--text) 2%, transparent);
  color: var(--text);
  font: inherit;
  font-size: var(--text-sm);
  transition: border-color 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
}
.ra-modal-input::placeholder { color: color-mix(in srgb, var(--muted) 75%, transparent); }
.ra-modal-input:hover { border-color: color-mix(in srgb, var(--border) 100%, var(--text) 5%); }
.ra-modal-input:focus {
  outline: none;
  background: var(--surface);
  border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
}

/* Duration cards — 2-column grid with main label + subtitle + check icon */
.ra-duration-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-2);
}
.ra-duration-option { position: relative; cursor: pointer; }
.ra-duration-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.ra-duration-content {
  display: block;
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  user-select: none;
  transition: background 0.12s ease, border-color 0.12s ease;
}
.ra-duration-option:hover .ra-duration-content {
  border-color: color-mix(in srgb, var(--border) 100%, var(--text) 8%);
  background: color-mix(in srgb, var(--text) 3%, transparent);
}
.ra-duration-main {
  display: block;
  font-size: var(--text-sm);
  font-weight: 500;
  color: var(--text);
  letter-spacing: -0.005em;
}
.ra-duration-hint {
  display: block;
  font-size: 11px;
  color: var(--muted);
  margin-top: 2px;
}
.ra-duration-check {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 14px;
  height: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 0.12s ease;
  pointer-events: none;
}
.ra-duration-option:has(input[type="radio"]:checked) .ra-duration-content {
  background: color-mix(in srgb, var(--accent) 8%, var(--surface));
  border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
}
.ra-duration-option:has(input[type="radio"]:checked) .ra-duration-check { opacity: 1; }
.ra-duration-option:has(input[type="radio"]:checked) .ra-duration-main {
  color: var(--text);
}

.ra-modal-foot {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-5);
  border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  background: color-mix(in srgb, var(--text) 2%, transparent);
}

@media (max-width: 520px) {
  .settings-page { padding: var(--space-7) var(--space-4) var(--space-8); }
  .settings-section-head-row { flex-direction: column; align-items: stretch; }
  .ra-new-btn { justify-content: center; }
  .ra-duration-options { grid-template-columns: 1fr 1fr; }
  .ra-tunnel-head { row-gap: var(--space-2); }
}
</style>

<script>
(function () {
  const list = document.getElementById('ra-list');
  const openBtn = document.getElementById('ra-open-modal');
  const modal = document.getElementById('ra-modal');
  const modalForm = document.getElementById('ra-modal-form');
  const modalSubmit = document.getElementById('ra-modal-submit');
  const cancelBtn1 = document.getElementById('ra-modal-cancel');
  const cancelBtn2 = document.getElementById('ra-modal-cancel2');
  const labelInput = document.getElementById('ra-modal-label');
  if (!list || !openBtn || !modal || !modalForm || !modalSubmit) return;

  /* ─── helpers ─── */
  function fmtRemaining(ms) {
    if (!ms || ms <= 0) return 'expired';
    const sec = Math.floor(ms / 1000);
    const min = Math.floor(sec / 60);
    const hr  = Math.floor(min / 60);
    const day = Math.floor(hr / 24);
    if (day >= 1) return day + 'd ' + (hr % 24) + 'h left';
    if (hr  >= 1) return hr  + 'h ' + (min % 60) + 'm left';
    if (min >= 1) return min + 'm ' + (sec % 60) + 's left';
    return sec + 's left';
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return c === '&' ? '&amp;' : c === '<' ? '&lt;' : c === '>' ? '&gt;' : c === '"' ? '&quot;' : '&#39;';
    });
  }
  const COPY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  const CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
  const EXT_ICON = '<svg class="ra-extlink-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>';

  async function copy(text, btn) {
    try { await navigator.clipboard.writeText(text); }
    catch (e) { console.warn('clipboard write failed', e); return; }
    if (!btn) return;
    const origHtml = btn.innerHTML;
    btn.innerHTML = CHECK_ICON;
    btn.classList.add('is-copied');
    btn.disabled = true;
    setTimeout(function () {
      btn.innerHTML = origHtml;
      btn.classList.remove('is-copied');
      btn.disabled = false;
    }, 1200);
  }

  /* ─── render ─── */
  function renderCard(t) {
    const urlBlock = t.url
      ? '<div class="ra-field-value-row">' +
        '  <a class="ra-url" data-role="url" href="' + escapeHtml(t.url) + '" target="_blank" rel="noopener noreferrer">' +
        '    <span class="ra-url-text">' + escapeHtml(t.url) + '</span>' +
        '    ' + EXT_ICON +
        '  </a>' +
        '  <button type="button" class="ra-copy-btn" data-copy="url" aria-label="Copy URL" title="Copy URL">' + COPY_ICON + '</button>' +
        '</div>'
      : '<div class="ra-connecting" data-role="url-pending"><span class="ra-spinner" aria-hidden="true"></span><span>Connecting…</span></div>';

    const labelChip = t.label
      ? '<span class="ra-tunnel-label">' + escapeHtml(t.label) + '</span>'
      : '';

    return '<div class="ra-tunnel-card" data-tunnel-id="' + escapeHtml(t.id) + '">' +
      '  <div class="ra-tunnel-head">' +
      '    <span class="ra-status"><span class="ra-status-dot" aria-hidden="true"></span><span class="ra-status-text">Live</span></span>' +
      '    ' + labelChip +
      '    <span class="ra-remaining" data-role="remaining" data-expires-at="' + t.expiresAt + '">' + fmtRemaining(t.expiresAt - Date.now()) + '</span>' +
      '  </div>' +
      '  <div class="ra-field">' +
      '    <div class="ra-field-label">URL</div>' +
      '    ' + urlBlock +
      '  </div>' +
      '  <div class="ra-field">' +
      '    <div class="ra-field-label">Passphrase</div>' +
      '    <div class="ra-field-value-row">' +
      '      <code class="ra-passphrase" data-role="passphrase">' + escapeHtml(t.passphrase) + '</code>' +
      '      <button type="button" class="ra-copy-btn" data-copy="passphrase" aria-label="Copy passphrase" title="Copy passphrase">' + COPY_ICON + '</button>' +
      '    </div>' +
      '  </div>' +
      '  <div class="ra-card-foot">' +
      '    <button type="button" class="ra-disable-link" data-action="delete">Disable</button>' +
      '  </div>' +
      '</div>';
  }

  function emptyState() {
    return '<div class="ra-empty">' +
      '  <svg class="ra-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
      '    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>' +
      '    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>' +
      '  </svg>' +
      '  <p class="ra-empty-text">No active tunnels.</p>' +
      '  <p class="ra-empty-hint">Click <strong>New tunnel</strong> to share access from another device.</p>' +
      '</div>';
  }

  function renderList(tunnels) {
    if (!tunnels || tunnels.length === 0) { list.innerHTML = emptyState(); return; }
    list.innerHTML = tunnels.map(renderCard).join('');
  }

  function tickRemaining() {
    const now = Date.now();
    list.querySelectorAll('[data-role="remaining"]').forEach(function (el) {
      const at = Number(el.getAttribute('data-expires-at'));
      if (!at) return;
      el.textContent = fmtRemaining(at - now);
    });
  }

  /* ─── polling ─── */
  async function fetchStatus() {
    const res = await fetch('/api/remote-access/tunnels');
    if (!res.ok) return null;
    return res.json();
  }
  let pollTimer = null;
  function startPolling() { if (!pollTimer) pollTimer = setInterval(poll, 1500); }
  function stopPolling()  { if (pollTimer) { clearInterval(pollTimer); pollTimer = null; } }
  async function poll() {
    if (document.hidden) return;
    const data = await fetchStatus();
    if (!data) return;
    renderList(data.tunnels);
    tickRemaining();
  }
  setInterval(tickRemaining, 1000);

  /* ─── list interactions ─── */
  list.addEventListener('click', async function (e) {
    const t = e.target instanceof Element ? e.target.closest('[data-copy], [data-action]') : null;
    if (!(t instanceof HTMLElement)) return;

    if (t.hasAttribute('data-copy')) {
      const role = t.getAttribute('data-copy');
      const card = t.closest('[data-tunnel-id]');
      if (!card) return;
      const valueEl = card.querySelector('[data-role="' + role + '"]');
      if (valueEl) copy((valueEl.textContent || '').trim(), t);
      return;
    }

    if (t.getAttribute('data-action') === 'delete') {
      const card = t.closest('[data-tunnel-id]');
      if (!card) return;
      const id = card.getAttribute('data-tunnel-id');
      if (!id) return;
      if (!confirm('Disable this tunnel? Anyone currently connected through it will be cut off.')) return;
      t.disabled = true;
      const orig = t.textContent;
      t.textContent = 'Disabling…';
      try {
        const res = await fetch('/api/remote-access/tunnels/' + encodeURIComponent(id), { method: 'DELETE' });
        if (!res.ok) {
          alert('Failed to disable');
          t.disabled = false;
          t.textContent = orig;
          return;
        }
        await poll();
      } catch (e2) {
        alert('Failed to disable: ' + e2.message);
        t.disabled = false;
        t.textContent = orig;
      }
    }
  });

  /* ─── modal ─── */
  function openModal() {
    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
    setTimeout(function () { if (labelInput) labelInput.focus(); }, 50);
  }
  function closeModal() {
    if (modal.open) modal.close();
    else modal.removeAttribute('open');
    if (labelInput) labelInput.value = '';
  }

  openBtn.addEventListener('click', openModal);
  cancelBtn1.addEventListener('click', closeModal);
  cancelBtn2.addEventListener('click', closeModal);

  // Close when clicking outside the form (on the ::backdrop area).
  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeModal();
  });

  modalForm.addEventListener('submit', async function (e) {
    e.preventDefault();
    const checked = modalForm.querySelector('input[name="durationMs"]:checked');
    if (!checked) return;
    const durationMs = Number(checked.value);
    const label = (labelInput && labelInput.value.trim()) || null;

    modalSubmit.disabled = true;
    const origText = modalSubmit.textContent;
    modalSubmit.textContent = 'Creating…';
    try {
      const res = await fetch('/api/remote-access/tunnels', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ durationMs, label }),
      });
      if (!res.ok) {
        const err = await res.json().catch(function () { return { error: 'failed' }; });
        alert('Failed to create: ' + (err.error || res.status));
      } else {
        closeModal();
        await poll();
      }
    } catch (e3) {
      alert('Failed to create: ' + e3.message);
    } finally {
      modalSubmit.disabled = false;
      modalSubmit.textContent = origText;
    }
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) stopPolling();
    else startPolling();
  });

  startPolling();
})();
</script>

<%- include('partials/foot') %>
