}
.or-usage-grid { display: flex; gap: var(--space-10); }
.or-usage-value {
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
