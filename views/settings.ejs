}
.ra-modal-group-input::placeholder {
  color: color-mix(in srgb, var(--muted) 70%, transparent);
}
.ra-modal-group-input:focus {
  outline: none;
}

/* macOS-style segmented control (Expires after) */
.ra-duration-field { gap: var(--space-2); }
.ra-duration-legend {
  display: block;
  width: 100%;
  padding: 0 var(--space-1);
  margin: 0 0 var(--space-1);
  font-size: var(--text-xs);
  font-weight: 400;
  letter-spacing: 0;
  color: var(--muted);
  text-transform: none;
}
.ra-duration-segmented {
  display: flex;
  align-items: stretch;
  padding: 2px;
  border-radius: var(--radius-md);
  background: color-mix(in srgb, var(--text) 7%, var(--surface));
  box-shadow: inset 0 0 0 0.5px color-mix(in srgb, var(--border) 55%, transparent);
}
.ra-duration-seg {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  cursor: pointer;
}
.ra-duration-seg + .ra-duration-seg::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18%;
  bottom: 18%;
  width: 0.5px;
  background: color-mix(in srgb, var(--border) 70%, transparent);
  pointer-events: none;
  z-index: 1;
}
.ra-duration-seg:has(input:checked)::before,
.ra-duration-seg:has(input:checked) + .ra-duration-seg::before {
  opacity: 0;
}
.ra-duration-seg input[type="radio"] {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.ra-duration-seg-label {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  margin: 0;
  border-radius: calc(var(--radius-md) - 2px);
  font-size: 0.8125rem;
  font-weight: 400;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--text);
  opacity: 0.72;
  user-select: none;
  transition:
    opacity 0.15s ease,
    background 0.15s ease,
    box-shadow 0.15s ease,
    font-weight 0.15s ease;
}
.ra-duration-seg:hover .ra-duration-seg-label { opacity: 0.92; }
.ra-duration-seg:has(input:checked) .ra-duration-seg-label {
  opacity: 1;
  font-weight: 500;
  background: var(--surface);
  box-shadow:
    0 1px 2px color-mix(in srgb, #000 14%, transparent),
    0 0 0 0.5px color-mix(in srgb, #000 8%, transparent);
}
.ra-duration-seg:has(input:focus-visible) .ra-duration-seg-label {
  outline: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
  outline-offset: 0;
}

.ra-modal-foot {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0 var(--space-5) var(--space-5);
}

/* ───────────── Voice (OpenRouter) ───────────── */
.or-card {
  background: var(--surface);
  border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
}

/* Connected — status row */
.or-status-row { display: flex; align-items: center; gap: var(--space-3); }
.or-dot {
  flex-shrink: 0;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--approve, #2da44e);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--approve, #2da44e) 22%, transparent);
}
.or-status-text { flex: 1; min-width: 0; }
.or-status-title {
  font-size: var(--text-sm);
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.01em;
}
.or-key {
  display: block;
  margin-top: 2px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: var(--text-xs);
  color: var(--muted);
}

/* Connected — usage readout */
.or-usage {
  margin-top: var(--space-5);
  padding-top: var(--space-5);
  border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
}
.or-usage-loading {
  display: flex; align-items: center; gap: var(--space-2);
