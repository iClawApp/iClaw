{
  "name": "@iclawapp/iclaw",
  "version": "0.4.0",
  "description": "Local web UI for OpenClaw Gateway",
  "main": "electron/main.js",
  "author": "iClaw",
  "license": "MIT",
  "homepage": "https://github.com/iClawApp/iClaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/iClawApp/iClaw.git"
  },
  "bugs": {
    "url": "https://github.com/iClawApp/iClaw/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "iclaw": "bin/iclaw.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "views"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "vendor": "node scripts/copy-opaque-vendor.mjs",
    "prebuild": "node scripts/copy-opaque-vendor.mjs",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:secure-image": "bash packages/iclaw-runtime/container/build-secure.sh",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/copy-opaque-vendor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ra-smoke": "vitest run test/unit/remoteAccessE2eSmoke.test.ts",
    "test:ra-integration": "npm run build && node scripts/ra-e2e-integration.mjs",
    "smoke:ra-manual": "node scripts/ra-e2e-smoke.mjs",
    "scan:relay-capture": "node scripts/ra-relay-capture-scan.mjs",
    "prepack": "node scripts/copy-opaque-vendor.mjs && node scripts/verify-vendor-assets.mjs && npm run build",
    "verify:vendor": "node scripts/verify-vendor-assets.mjs",
    "build:runtime": "npm --workspace @iclaw/runtime run build",
    "build:desktop": "npm run build && npm run build:runtime",
    "electron": "electron electron/main.js",
    "electron:dev": "npm run build:desktop && npm run electron",
    "vendor:node": "node scripts/vendor-node.mjs",
    "pack:mac": "npm run build:desktop && npm run vendor:node && electron-builder --mac --dir",
    "dist:mac": "npm run build:desktop && npm run vendor:node && electron-builder --mac",
    "release": "bash scripts/release.sh",
    "release:publish": "bash scripts/release.sh always"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@serenity-kit/opaque": "^1.1.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "electron-updater": "^6.8.9",
    "express": "^4.21.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "highlight.js": "^11.11.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
