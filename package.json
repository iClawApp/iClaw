{
  "name": "@iclawapp/iclaw",
  "version": "0.1.1",
  "description": "Local web UI for OpenClaw Gateway",
  "license": "MIT",
  "homepage": "https://github.com/iClawApp/iClaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iClawApp/iClaw.git"
  },
  "bugs": {
    "url": "https://github.com/iClawApp/iClaw/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "iclaw": "bin/iclaw.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "views"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "highlight.js": "^11.11.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
