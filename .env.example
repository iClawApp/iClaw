# All optional. iClaw reads gateway.auth.token from ~/.openclaw/openclaw.json
# and uses http://127.0.0.1:18789 by default.
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_API_KEY=

PORT=3000
DB_PATH=./data/iclaw.db

# Optional: iClaw-cloud origin for encrypted share links. Defaults to
# https://app.iclaw.digital when unset. Set to false, 0, off, or disabled to
# hide the Share button. The browser POSTs ciphertext here — iClaw never
# relays share traffic. Put the same origin in iClaw-cloud BASE_URL so any
# server-generated metadata stays consistent (the share modal link is built
# from this value in the browser).
# ICLAW_CLOUD_URL=http://localhost:4000
