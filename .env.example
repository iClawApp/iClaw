# Both are OPTIONAL. By default iClaude reads gateway.auth.token from
# ~/.openclaw/openclaw.json and uses http://127.0.0.1:18789 (or
# OPENCLAW_GATEWAY_PORT from ~/.openclaw/service-env/ai.openclaw.gateway.env).
# Set these only to override.
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_API_KEY=

# Server
PORT=3000

# SQLite DB path (relative to project root)
DB_PATH=./data/iclaude.db
