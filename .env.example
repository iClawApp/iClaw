# All optional. iClaw reads gateway.auth.token from ~/.openclaw/openclaw.json
# and uses http://127.0.0.1:18789 by default.
# OPENCLAW_BASE_URL=http://127.0.0.1:18789
# OPENCLAW_API_KEY=

PORT=3000
DB_PATH=./data/iclaw.db

# Optional: end-to-end encrypted chat sharing via iClaw-cloud.
# When unset, the "Share" button is hidden. Set to the public origin of your
# iClaw-cloud deployment (https://github.com/tmlxrd/iClaw-cloud). The browser
# encrypts in WebCrypto and POSTs ciphertext directly to this URL — iClaw
# never relays share traffic and never sees the key.
# ICLAW_CLOUD_URL=http://localhost:4000
