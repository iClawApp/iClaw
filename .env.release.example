# Per-machine release config for the macOS desktop app.
# Copy this file to `.env.release` (gitignored) and fill in your values.
# See docs/desktop-release.md for the full walkthrough.
#
# NOTE: the Apple app-specific password is NOT stored here — it lives in the
# macOS Keychain (created once via `xcrun notarytool store-credentials`). This
# file holds only non-secret identifiers, plus an optional GitHub token.

# notarytool keychain profile name (from `store-credentials`):
APPLE_KEYCHAIN_PROFILE=iclaw-notarize

# Your "Developer ID Application" signing identity, WITHOUT the type prefix
# (run: security find-identity -v -p codesigning):
CSC_NAME="Your Name (TEAMID)"
APPLE_TEAM_ID=TEAMID

# Only needed for `npm run release:publish` — a GitHub token with `repo` scope:
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
